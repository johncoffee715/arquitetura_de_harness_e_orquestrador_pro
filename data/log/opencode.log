timestamp=2026-07-10T22:36:07.745Z level=INFO run=64d83dc1 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport struct\n\nwith open('/sys/class/drm/card1/device/pp_table', 'rb') as f:\n    data = bytearray(f.read())\n\n# Step 2: From step1 values -> step2 values\n# SCLK: 1750 (0x06D6) -> 1800 (0x0708)\n# MCLK: 1040 (0x0410) -> 1080 (0x0438)\npatches = [\n    (842, 0x06D6, 0x0708, \"SCLK max DPM table\"),\n    (1010, 0x06D6, 0x0708, \"SCLK max copy 1\"),\n    (1066, 0x06D6, 0x0708, \"SCLK max copy 2\"),\n    (926, 0x0410, 0x0438, \"MCLK max DPM table\"),\n    (928, 0x0410, 0x0438, \"MCLK max copy\"),\n]\n\nfor off, orig_val, new_val, desc in patches:\n    current = struct.unpack('<H', data[off:off+2])[0]\n    if current != orig_val:\n        print(f\"⚠️  {desc}: expected 0x{orig_val:04x}, got 0x{current:04x}\")\n        continue\n    struct.pack_into('<H', data, off, new_val)\n    print(f\"✅ {desc}: {orig_val} MHz -> {new_val} MHz\")\n\nwith open('/tmp/pp_table_step2.bin', 'wb') as f:\n    f.write(data)\nprint(\"\\n✅ Saved /tmp/pp_table_step2.bin\")\nPYEOF" action.permission=bash action.pattern="python3 *" action.action=allow
