timestamp=2026-07-12T23:46:20.925Z level=INFO run=56d81d33 message=evaluated permission=bash pattern="cat << 'PYEOF' > /tmp/fix_launchers.py\nimport json, os, sqlite3, time, re, zlib\n\n# =============================================\n# GAME DATABASE\n# =============================================\nall_games = [\n    # win1\n    (\"BioShock Infinite\", \"/mnt/win1/games/BioShock Infinite/Binaries/Win32/BioShockInfinite.exe\"),\n    (\"Bloodborne\", \"/mnt/win1/games/Bloodborne/Bloodborne.exe\"),\n    (\"Bloodstained - Ritual of the Night\", \"/mnt/win1/games/Bloodstained - Ritual of the Night/BloodstainedRotN.exe\"),\n    (\"Devil May Cry 5\", \"/mnt/win1/games/Devil May Cry 5/DevilMayCry5.exe\"),\n    (\"ELDEN RING NIGHTREIGN\", \"/mnt/win1/games/ELDEN RING NIGHTREIGN/Game/nightreign.exe\"),\n    (\"God of War Ragnarok\", \"/mnt/win1/games/God of War Ragnarok/GoWR.exe\"),\n    (\"Lies of P\", \"/mnt/win1/games/Lies of P/LOP.exe\"),\n    (\"Middle Earth Shadow of Mordor GOTY\", \"/mnt/win1/games/Middle Earth Shadow of Mordor GOTY/x64/ShadowOfMordor.exe\"),\n    (\"Ninja Gaiden 4\", \"/mnt/win1/games/Ninja Gaiden 4/NINJAGAIDEN4-Steam.exe\"),\n    (\"Silent Hill f\", \"/mnt/win1/games/Silent Hill f/SHf.exe\"),\n    (\"Tekken 8\", \"/mnt/win1/games/Tekken 8/TEKKEN 8.exe\"),\n    (\"The House of the Dead 2 Remake\", \"/mnt/win1/games/The House of the Dead 2 Remake/THE HOUSE OF THE DEAD 2 Remake.exe\"),\n    (\"The Last of Us Part II Remastered\", \"/mnt/win1/games/The Last of Us Part II Remastered/tlou-ii-l.exe\"),\n    # win2\n    (\"Battlefield 1\", \"/mnt/win2/games/Battlefield 1/bf1.exe\"),\n    (\"BioShock 2 Remastered\", \"/mnt/win2/games/BioShock 2 Remastered/Build/Final/Bioshock2HD.exe\"),\n    (\"BioShock Remastered\", \"/mnt/win2/games/BioShock Remastered/Build/Final/BioshockHD.exe\"),\n    (\"Castlevania Lords of Shadow 2\", \"/mnt/win2/games/Castlevania Lords of Shadow 2/bin/CLOS2.exe\"),\n    (\"Castlevania - Lords of Shadow UE\", \"/mnt/win2/games/Castlevania - Lords of Shadow UE/bin/CastlevaniaLoSUE.exe\"),\n    (\"Crysis 2\", \"/mnt/win2/games/Crytek/Crysis 2/bin32/Crysis2.exe\"),\n    (\"Crysis 3\", \"/mnt/win2/games/Crytek/Crysis 3/Bin32/Crysis3.exe\"),\n    (\"Devil May Cry HD Collection\", \"/mnt/win2/games/Devil May Cry HD Collection/dmcLauncher.exe\"),\n    (\"Dying Light\", \"/mnt/win2/games/Dying Light/DyingLightGame.exe\"),\n    (\"Forza Horizon 6\", \"/mnt/win2/games/Forza Horizon 6/forzahorizon6.exe\"),\n    (\"God of War\", \"/mnt/win2/games/God of War/GoW.exe\"),\n    (\"Gungrave G.O.R.E\", \"/mnt/win2/games/Gungrave G.O.R.E/GunGraveGore.exe\"),\n    (\"Mad Max\", \"/mnt/win2/games/Mad Max/AVAMain.exe\"),\n    (\"Mafia II\", \"/mnt/win2/games/Mafia II/pc/mafia2.exe\"),\n    (\"Marvel's Spider-Man 2\", \"/mnt/win2/games/Marvel's Spider-Man 2/Spider-Man2.exe\"),\n    (\"Metro 2033 Redux\", \"/mnt/win2/games/Metro 2033 Redux/Metro2033Redux/metro.exe\"),\n    (\"Metro Exodus\", \"/mnt/win2/games/Metro Exodus/MetroExodus.exe\"),\n    (\"Metro Last Light Redux\", \"/mnt/win2/games/Metro Last Light Redux/metro.exe\"),\n    (\"Need for Speed Most Wanted\", \"/mnt/win2/games/Need for Speed Most Wanted/NFS13.exe\"),\n    (\"Need for Speed - Rivals\", \"/mnt/win2/games/Need for Speed - Rivals/NFS14.exe\"),\n    (\"RESIDENT EVIL 2\", \"/mnt/win2/games/RESIDENT EVIL 2/re2.exe\"),\n    (\"Resident Evil 3\", \"/mnt/win2/games/Resident Evil 3/re3.exe\"),\n    (\"Resident Evil 6\", \"/mnt/win2/games/Resident Evil 6/BH6.exe\"),\n    (\"Ryse - Son of Rome\", \"/mnt/win2/games/Ryse - Son of Rome/Bin64/Ryse.exe\"),\n    (\"Sekiro Shadows Die Twice\", \"/mnt/win2/games/Sekiro Shadows Die Twice/sekiro.exe\"),\n    (\"Silver Night Crusaders\", \"/mnt/win2/games/Silver_Night_Crusaders_[v1.1]/Silver_Night's_Crusaders.exe\"),\n    (\"Star Wars Jedi Fallen Order\", \"/mnt/win2/games/Star Wars Jedi Fallen Order/SwGame/Binaries/Win64/starwarsjedifallenorder.exe\"),\n    (\"The Witcher 3 Wild Hunt\", \"/mnt/win2/games/The Witcher 3 Wild Hunt/bin/x64/witcher3.exe\"),\n]\n\n# NFS Rivals FPS unlock launch arguments (from Brawltendo mod)\nNFS_FPS_ARGS = \"-Client.VisualFrameInterpolation 1 -GameTime.MaxVariableFps 200 -RenderDevice.VsyncEnable 0 -Ant.InterpolatePoses 0\"\n\n# =============================================\n# UTILITY\n# =============================================\ndef slugify(title):\n    s = title.lower().replace(\"'\", \"\").replace(\".\", \"\").replace(\"™\", \"\")\n    s = re.sub(r'[^a-z0-9]+', '-', s).strip('-')\n    s = re.sub(r'-+', '-', s)\n    return s\n\ndef make_heroic_app_name(title):\n    \"\"\"Generate unique app_name - use hash of title\"\"\"\n    import hashlib\n    return \"game_\" + hashlib.md5(title.encode()).hexdigest()[:20]\n\nHEROIC_PREFIX = os.path.expanduser(\"~/Games/Heroic/Prefixes\")\nPROTON_BIN = \"/home/johncoffee/.config/heroic/tools/proton/GE-Proton-latest/proton\"\n\n# =============================================\n# HEROIC CONFIG\n# =============================================\nprint(\"=\"*60)\nprint(\"GENERATING HEROIC CONFIG\")\nprint(\"=\"*60)\n\nheroic_lib_path = os.path.expanduser(\"~/.config/heroic/sideload_apps/library.json\")\nheroic_gc_dir = os.path.expanduser(\"~/.config/heroic/GamesConfig\")\n\n# Load existing to preserve original 3 nanoid entries\nexisting_entries = {}\nif os.path.exists(heroic_lib_path):\n    with open(heroic_lib_path) as f:\n        lib_data = json.load(f)\n    for g in lib_data.get(\"games\", []):\n        existing_entries[g[\"app_name\"]] = g\n\nos.makedirs(os.path.dirname(heroic_lib_path), exist_ok=True)\nos.makedirs(heroic_gc_dir, exist_ok=True)\n\n# Map slug -> entry data for NFS Rivals detection\nnew_library = []\ngamesconfig_created = 0\n\nfor title, exe in all_games:\n    folder = os.path.dirname(exe)\n    \n    # Check if already exists by nanoid (original 3)\n    existing_match = None\n    for aname, entry in existing_entries.items():\n        if entry.get(\"title\",\"\").lower() == title.lower():\n            existing_match = entry\n            break\n    \n    if existing_match:\n        # Keep original entry, just update if needed\n        app_name = existing_match[\"app_name\"]\n        new_library.append(existing_match)\n        print(f\"  [KEEP] {title}\")\n    else:\n        app_name = make_heroic_app_name(title)\n        new_entry = {\n            \"runner\": \"sideload\",\n            \"app_name\": app_name,\n            \"title\": title,\n            \"install\": {\n                \"executable\": exe,\n                \"platform\": \"Windows\",\n                \"is_dlc\": False\n            },\n            \"folder_name\": folder,\n            \"art_cover\": \"\",\n            \"is_installed\": True,\n            \"art_square\": \"\",\n            \"canRunOffline\": True,\n            \"browserUrl\": \"\",\n            \"customUserAgent\": \"\",\n            \"launchFullScreen\": False\n        }\n        new_library.append(new_entry)\n        print(f\"  [ADD]  {title} -> {app_name}\")\n    \n    # Create/update GamesConfig\n    gc_path = os.path.join(heroic_gc_dir, f\"{app_name}.json\")\n    \n    # NFS Rivals gets FPS unlock args via environment options\n    env_options = []\n    if title == \"Need for Speed - Rivals\":\n        env_options = [\n            {\"key\": \"WINEDLLOVERRIDES\", \"value\": \"d3d11=native,builtin\"}\n        ]\n    \n    gc_entry = {\n        app_name: {\n            \"autoInstallDxvk\": True,\n            \"autoInstallDxvkNvapi\": True,\n            \"autoInstallVkd3d\": True,\n            \"preferSystemLibs\": False,\n            \"enableEsync\": True,\n            \"enableMsync\": False,\n            \"enableFsync\": True,\n            \"enableWineWayland\": False,\n            \"enableHDR\": False,\n            \"enableWoW64\": False,\n            \"nvidiaPrime\": False,\n            \"enviromentOptions\": env_options,\n            \"wrapperOptions\": [],\n            \"showFps\": True,\n            \"showMangohud\": True,\n            \"useGameMode\": False,\n            \"battlEyeRuntime\": True,\n            \"eacRuntime\": True,\n            \"language\": \"\",\n            \"beforeLaunchScriptPath\": \"\",\n            \"afterLaunchScriptPath\": \"\",\n            \"verboseLogs\": True,\n            \"advertiseAvxForRosetta\": False,\n            \"enableQuickSavesMenu\": False,\n            \"wineVersion\": {\n                \"bin\": PROTON_BIN,\n                \"name\": \"GE-Proton-latest\",\n                \"type\": \"proton\"\n            },\n            \"winePrefix\": os.path.join(HEROIC_PREFIX, \"shared\"),\n            \"wineCrossoverBottle\": \"Heroic\"\n        },\n        \"version\": \"v0\",\n        \"explicit\": True\n    }\n    \n    # Special prefixes\n    if title == \"Silent Hill f\":\n        gc_entry[app_name][\"winePrefix\"] = os.path.join(HEROIC_PREFIX, \"silent hill f\")\n    elif title == \"Need for Speed - Rivals\":\n        gc_entry[app_name][\"winePrefix\"] = os.path.join(HEROIC_PREFIX, \"sideload\")\n    elif title == \"Forza Horizon 6\":\n        gc_entry[app_name][\"winePrefix\"] = os.path.join(HEROIC_PREFIX, \"shared\")\n    \n    with open(gc_path, \"w\") as f:\n        json.dump(gc_entry, f, indent=2)\n    gamesconfig_created += 1\n\n# Write library.json\nwith open(heroic_lib_path, \"w\") as f:\n    json.dump({\"games\": new_library}, f, indent=2)\nprint(f\"\\nHeroic library.json: {len(new_library)} games\")\nprint(f\"Heroic GamesConfig files: {gamesconfig_created}\")\n\n# =============================================\n# NFS RIVALS: Add launch arguments to Heroic\n# The sideload library entry needs the arguments\n# =============================================\nprint(\"\\n\" + \"=\"*60)\nprint(\"ADDING NFS RIVALS FPS UNLOCK ARGUMENTS\")\nprint(\"=\"*60)\n\n# Find NFS Rivals entry and add launch args\nfor entry in new_library:\n    if entry[\"title\"] == \"Need for Speed - Rivals\":\n        entry[\"install\"][\"arguments\"] = NFS_FPS_ARGS\n        print(f\"  Added FPS unlock args to Heroic: {NFS_FPS_ARGS}\")\n        break\n\n# Rewrite library.json with updated args\nwith open(heroic_lib_path, \"w\") as f:\n    json.dump({\"games\": new_library}, f, indent=2)\nprint(\"  library.json updated with launch arguments\")\n\n# =============================================\n# LUTRIS CONFIG\n# =============================================\nprint(\"\\n\" + \"=\"*60)\nprint(\"GENERATING LUTRIS CONFIG\")\nprint(\"=\"*60)\n\nlutris_games_dir = os.path.expanduser(\"~/.local/share/lutris/games\")\nlutris_db_path = os.path.expanduser(\"~/.local/share/lutris/pga.db\")\nlutris_prefix = os.path.expanduser(\"~/Games/Heroic/Prefixes/shared\")\nlutris_runner = \"Proton-GE Latest\"\n\nos.makedirs(lutris_games_dir, exist_ok=True)\n\n# Read existing DB\nconn = sqlite3.connect(lutris_db_path)\ncur = conn.cursor()\n\n# Get existing games\nexisting_db = {}\ntry:\n    cur.execute(\"SELECT id, name, configpath FROM games\")\n    for row in cur.fetchall():\n        existing_db[row[1].lower()] = {\"id\": row[0], \"configpath\": row[2]}\nexcept:\n    pass\n\nprint(f\"Existing Lutris DB games: {len(existing_db)}\")\n\nyaml_count = 0\ndb_count = 0\n\n# Use a consistent timestamp base\nbase_ts = int(time.time()) - 100000  # ensure uniqueness\n\nfor i, (title, exe) in enumerate(all_games):\n    folder = os.path.dirname(exe)\n    slug = slugify(title)\n    configpath = f\"{slug}-{base_ts + i}\"\n    yaml_filename = f\"{configpath}.yml\"\n    yaml_path = os.path.join(lutris_games_dir, yaml_filename)\n    \n    title_lower = title.lower()\n    \n    # Build args for NFS Rivals\n    game_args = \"\"\n    if title == \"Need for Speed - Rivals\":\n        game_args = NFS_FPS_ARGS\n    \n    # Create YAML file\n    yaml_content = f\"\"\"game:\n  exe: {exe}\n  prefix: {lutris_prefix}\n  working_dir: {folder}/\n  args: {game_args}\nsystem:\n  mangohud: true\nwine:\n  version: {lutris_runner}\n\"\"\"\n    if not game_args:\n        # Remove empty args line\n        yaml_content = yaml_content.replace(\"  args: \\n\", \"\")\n    \n    with open(yaml_path, \"w\") as f:\n        f.write(yaml_content)\n    yaml_count += 1\n    \n    # Insert/update DB\n    if title_lower in existing_db:\n        # Update existing entry\n        cur.execute(\"\"\"\n            UPDATE games SET runner=?, executable=?, directory=?, configpath=?, installed=1\n            WHERE lower(name)=?\n        \"\"\", (\"wine\", exe, folder, configpath, title_lower))\n        print(f\"  [UPDATE] {title}\")\n    else:\n        cur.execute(\"\"\"\n            INSERT INTO games (name, slug, runner, executable, directory, configpath, installed)\n            VALUES (?, ?, ?, ?, ?, ?, 1)\n        \"\"\", (title, slug, \"wine\", exe, folder, configpath))\n        print(f\"  [ADD]    {title}\")\n    db_count += 1\n\nconn.commit()\nconn.close()\n\nprint(f\"\\nLutris YAML files created/updated: {yaml_count}\")\nprint(f\"Lutris DB entries: {db_count}\")\n\n# =============================================\n# SUMMARY\n# =============================================\nprint(\"\\n\" + \"=\"*60)\nprint(\"NFS RIVALS FPS UNLOCK\")\nprint(\"=\"*60)\nprint(f\"  Mod files installed in game dir\")\nprint(f\"  Launch args: {NFS_FPS_ARGS}\")\nprint(f\"  WINEDLLOVERRIDES=d3d11=native,builtin set in Heroic config\")\nprint()\nprint(\"NOTE: Restart Heroic for changes to take effect.\")\nprint(\"Lutris changes are live on next launch.\")\n\nPYEOF" action.permission=* action.action=allow action.pattern=*
