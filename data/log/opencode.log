timestamp=2026-07-10T22:32:49.050Z level=INFO run=64d83dc1 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport struct\n\nwith open('/sys/class/drm/card1/device/pp_table', 'rb') as f:\n    data = f.read()\n\nprint(f\"Size: {len(data)} bytes\")\nprint(f\"First 64 bytes hex:\")\nfor i in range(0, min(64, len(data)), 16):\n    hex_str = ' '.join(f'{b:02x}' for b in data[i:i+16])\n    print(f\"  {i:4d}: {hex_str}\")\n\n# Parse known header fields for Vega20\n# The pp_table header typically has:\n# Offset  Size  Field\n# 0       2     usHeaderSize (or magic)\n# 2       2     usTableSize\n\nheader_size = struct.unpack('<H', data[0:2])[0]\nprint(f\"\\nHeader size (offset 0): {header_size}\")\n\n# For Vega20, the smc_pptable has known offsets\n# Let's try to find clock entries by scanning for frequency values\nprint(\"\\nScanning for potential clock frequency values (in MHz) in table:\")\nfor offset in range(0, len(data)-3, 4):\n    val = struct.unpack('<I', data[offset:offset+4])[0]\n    if 800 <= val <= 2500:  # SCLK range\n        print(f\"  offset {offset}: {val} MHz (0x{val:x})\")\n\nprint(\"\\nScanning for TDP values:\")\nfor offset in range(0, len(data)-3, 4):\n    val = struct.unpack('<I', data[offset:offset+4])[0]\n    if 50 <= val <= 500:\n        print(f\"  offset {offset}: {val}W (0x{val:x})\")\nPYEOF" action.permission=bash action.pattern="python3 *" action.action=allow
