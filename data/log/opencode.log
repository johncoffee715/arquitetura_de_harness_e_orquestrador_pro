timestamp=2026-07-13T12:03:40.083Z level=INFO run=04d92069 message=evaluated permission=bash pattern="cat > /home/johncoffee/apply-2140mhz.sh << 'SCRIPT'\n#!/bin/bash\n# apply-2140mhz.sh — Aplica pp_table 2140 MHz +50mV VDDC\n# Uso: sudo bash apply-2140mhz.sh\n\nset -e\n\nPP_SYS=\"/sys/class/drm/card1/device/pp_table\"\nOC_FILE=\"/mnt/dados/gpu-fw/mi50/pp_table_patches/pp_table_2140mhz.bin\"\nOD=\"/sys/class/drm/card1/device/pp_od_clk_voltage\"\n\necho \"[1/4] Carregando pp_table 2140 MHz...\"\ncat \"$OC_FILE\" > \"$PP_SYS\"\necho \"  OK\"\n\necho \"[2/4] Aplicando +50mV VDDC + override SCLK 2140 MHz...\"\necho \"s 8 2140\" > \"$OD\"\necho \"v 50\" > \"$OD\"\necho \"c\" > \"$OD\"\necho \"  OK\"\n\necho \"[3/4] Copiando daemon atualizado...\"\ncp /home/johncoffee/gpu-performance-daemon-v2.sh /usr/local/bin/gpu-performance-daemon.sh\nsystemctl restart gpu-performance-daemon.service\necho \"  OK\"\n\necho \"[4/4] Verificando clocks...\"\ncat /sys/class/drm/card1/device/pp_dpm_sclk\necho \"\"\necho \"=== PRONTO ===\"\necho \"Nível 8 = 2140 MHz com +50mV VDDC\"\necho \"\"\necho \"Para monitorar durante o jogo:\"\necho \"  watch -n 1 cat /sys/class/drm/card1/device/pp_dpm_sclk\"\necho \"  watch -n 1 cat /sys/class/drm/card1/device/hwmon/hwmon*/temp1_input\"\nSCRIPT" action.permission=* action.action=allow action.pattern=*
