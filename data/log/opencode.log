timestamp=2026-07-13T19:54:47.557Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport hashlib\n\norig = bytearray(open('277846.rom', 'rb').read())\npatched = bytearray(open('ProVII_Lenovo_OD_enabled.rom', 'rb').read())\n\nprint(f\"Tamanhos: orig={len(orig)}, patched={len(patched)}\")\nprint(f\"MD5 orig: {hashlib.md5(orig).hexdigest()}\")\nprint(f\"MD5 patched: {hashlib.md5(patched).hexdigest()}\")\n\n# Encontrar diferencas\ndiffs = []\nfor i in range(min(len(orig), len(patched))):\n    if orig[i] != patched[i]:\n        diffs.append((i, orig[i], patched[i]))\n\nprint(f\"\\nTotal de bytes diferentes: {len(diffs)}\")\nprint(\"\\nDiferencas (offset, orig, patched):\")\nfor off, ov, pv in diffs:\n    print(f\"  0x{off:05x}: 0x{ov:02x} -> 0x{pv:02x}\")\n\n# Procurar padrao de assinatura RSA no final ou posicao conhecida\n# Em VBIOS AMD, a assinatura fica por volta do final da ROM\n# Vamos procurar por blocos que sao identicos (provavelmente assinatura)\nprint(\"\\n--- Procurando blocos identicos no final da ROM ---\")\nfor off in range(len(orig) - 256, 0, -256):\n    if orig[off:off+256] == patched[off:off+256]:\n        blk = off\n        # Encontrar o inicio do bloco continuo\n        while blk > 0 and orig[blk-1:blk+255] == patched[blk-1:blk+255]:\n            blk -= 1\n        print(f\"  Bloco identico: 0x{blk:05x}-0x{off+255:05x} ({off+255-blk} bytes)\")\n        break\n\n# Procurar a assinatura RSA - geralmente e um bloco de 256 bytes (2048 bits)\n# ou 512 bytes (4096 bits) perto do final\nprint(\"\\n--- Procurando assinatura RSA (256/512 bytes identicos) ---\")\nfor size in [256, 512, 128, 2048]:\n    for off in range(0, len(orig) - size, size):\n        if orig[off:off+size] == patched[off:off+size]:\n            # Ver se o bloco tem bytes aleatorios (assinatura)\n            if off > 0x70000:\n                print(f\"  Bloco identico de {size} bytes em 0x{off:05x}-0x{off+size:05x}\")\n\n# Ver os ultimos 1024 bytes da ROM\nprint(\"\\n--- Ultimos 1024 bytes (identicos vs diferentes) ---\")\nfor off in range(len(orig)-1024, len(orig), 16):\n    same = \"SAME\" if orig[off:off+16] == patched[off:off+16] else \"DIFF\"\n    ohex = ' '.join(f'{b:02x}' for b in orig[off:off+16])\n    phex = ' '.join(f'{b:02x}' for b in patched[off:off+16])\n    if same == \"DIFF\":\n        print(f\"  0x{off:05x}: {same} orig={ohex} patched={phex}\")\n\nprint(\"\\n--- Procurando assinatura RSA por padrao ---\")\n# A assinatura RSA geralmente tem bytes que parecem aleatorios\n# Vamos procurar onde a ROM original e patched sao IGUAIS \n# (ou seja, a assinatura nao foi afetada)\n# e que estao em uma regiao que parece ser de assinatura\n\n# Tabela de diretorios ATOM esta geralmente no offset apontado pelo header\n# Vamos procurar a \"ATOM\" signature\nfor i in range(0x1000):\n    if orig[i:i+4] == b'ATOM':\n        print(f\"  ATOM BIOS table em 0x{i:05x}\")\n        break\n\n# A estrutura da tabela de diretorios AROM/BACKUP\nfor i in range(len(orig)):\n    if orig[i:i+4] in [b'ATOM', b'AROM', b'BIOS']:\n        if i < 0x100:\n            print(f\"  Signature em 0x{i:05x}: {orig[i:i+8]}\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
