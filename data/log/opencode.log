timestamp=2026-07-10T22:40:14.054Z level=INFO run=64d83dc1 message=evaluated permission=bash pattern="pkexec bash -c 'cat > /usr/local/bin/apply-gpu-patch.sh << '\"'\"'SCRIPT'\"'\"'\n#!/bin/bash\n# Aplica TDP 350W + Overclock 2000MHz na Radeon Pro VII via pp_table\n\nPP_TABLE_SYS=\"/sys/class/drm/card1/device/pp_table\"\nPP_TABLE_PCI=\"/sys/bus/pci/devices/0000:05:00.0/drm/card1/device/pp_table\"\n\n# Usar o sysfs path que funcionar\nTARGET=\"\"\n[ -w \"$PP_TABLE_SYS\" ] && TARGET=\"$PP_TABLE_SYS\"\n[ -z \"$TARGET\" ] && [ -w \"$PP_TABLE_PCI\" ] && TARGET=\"$PP_TABLE_PCI\"\n\nif [ -n \"$TARGET\" ]; then\n    # Carregar pp_table com TDP 350W\n    TDP_FILE=\"/mnt/dados/gpu-fw/mi50/patched/mi50_350w_tdc300a.bin\"\n    if [ -f \"$TDP_FILE\" ]; then\n        cat \"$TDP_FILE\" > \"$TARGET\"\n        logger \"[gpu-patch] TDP 350W aplicado\"\n    fi\n    \n    # Aplicar overclock 2000MHz via pp_table\n    OC_FILE=\"/mnt/dados/gpu-fw/mi50/pp_table_patches/pp_table_overclocked_final.bin\"\n    if [ -f \"$OC_FILE\" ]; then\n        cat \"$OC_FILE\" > \"$TARGET\"\n        logger \"[gpu-patch] Overclock 2000MHz aplicado\"\n    fi\nelse\n    logger \"[gpu-patch] ERRO: pp_table sysfs nao encontrado\"\nfi\n\n# Forçar performance level high para ativar clocks máximos\necho \"high\" > /sys/class/drm/card1/device/power_dpm_force_performance_level 2>/dev/null\nlogger \"[gpu-patch] Performance level set to high\"\nSCRIPT'" action.permission=bash action.pattern="pkexec *" action.action=allow
