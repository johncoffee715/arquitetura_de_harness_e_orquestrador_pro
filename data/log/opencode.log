timestamp=2026-07-13T17:57:15.548Z level=INFO run=007f36c8 message=evaluated permission=bash pattern="python3 -c \"\nimport json, os, re\n\nconfig_dir = os.path.expanduser('~/.config/heroic/GamesConfig')\nlib_path = os.path.expanduser('~/.config/heroic/sideload_apps/library.json')\n\n# Load library to map app_name -> title\nwith open(lib_path) as f:\n    lib = json.load(f)\ntitle_map = {g['app_name']: g['title'] for g in lib['games']}\n\n# Slugify title for prefix folder name\ndef slugify(title):\n    s = title.lower().strip()\n    s = re.sub(r'[^a-z0-9]+', '-', s)\n    s = s.strip('-')\n    return s\n\nchanges = 0\nfor fname in os.listdir(config_dir):\n    if not fname.endswith('.json'):\n        continue\n    app_name = fname[:-5]\n    fpath = os.path.join(config_dir, fname)\n    \n    with open(fpath) as f:\n        data = json.load(f)\n    \n    cfg = data.get(app_name, {})\n    old_prefix = cfg.get('winePrefix', '')\n    \n    # Skip if already has its own prefix (not shared or sideload)\n    base = os.path.basename(old_prefix)\n    if base not in ('shared', 'sideload'):\n        continue\n    \n    # Generate unique prefix per game\n    title = title_map.get(app_name, app_name)\n    slug = slugify(title)\n    new_prefix = f'/home/johncoffee/Games/Heroic/Prefixes/{slug}'\n    \n    if old_prefix == new_prefix:\n        continue\n    \n    cfg['winePrefix'] = new_prefix\n    data[app_name] = cfg\n    \n    with open(fpath, 'w') as f:\n        json.dump(data, f, indent=2)\n    \n    print(f'{old_prefix.split(\\\"/\\\")[-1]:15s} -> {slug:40s} ({title})')\n    changes += 1\n\nprint(f'\\nTotal configs updated: {changes}')\n\"" action.permission=* action.action=allow action.pattern=*
