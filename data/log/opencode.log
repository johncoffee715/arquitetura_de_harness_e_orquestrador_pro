timestamp=2026-07-13T19:30:11.684Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="sudo -S bash -c '\necho \"=== Verificar WRITE_PROTECT (0x12) ===\"\necho \"VRM GFX (0x30):\"\ni2cget -y 0 0x30 0x12 w 2>&1\necho \"IR35217 SoC (0x32):\"\ni2cget -y 0 0x32 0x12 w 2>&1\n\necho \"\"\necho \"=== Desbloquear WRITE_PROTECT (0x12 = 0x00 = allow all writes) ===\"\n# PMBus WRITE_PROTECT: 0x00 = allow all, 0x40 = write protect fault, 0x80 = read only\necho \"Desbloqueando VRM GFX (0x30)...\"\ni2cset -y 0 0x30 0x12 0x00 w 2>&1\nsleep 0.5\necho \"Verificando:\"\ni2cget -y 0 0x30 0x12 w 2>&1\n\necho \"\"\necho \"Desbloqueando IR35217 SoC (0x32)...\"\ni2cset -y 0 0x32 0x12 0x00 w 2>&1\nsleep 0.5\necho \"Verificando:\"\ni2cget -y 0 0x32 0x12 w 2>&1\n\necho \"\"\necho \"=== Agora tentar OCP=330A no VRM GFX novamente ===\"\n# 330A em LINEAR11 com exp=-1: 330*2 = 660 = 0x0290\n# Mas se for formato direto: 330 = 0x014a\n# Tentar ambos\necho \"Tentativa 1: 0x014a (direto 330A)...\"\ni2cset -y 0 0x30 0x3B 0x014a w 2>&1\nsleep 0.5\necho \"Verificando:\"\ni2cget -y 0 0x30 0x3B w 2>&1\n\necho \"\"\necho \"Tentativa 2: 0x0290 (LINEAR11 exp=-1)...\"\ni2cset -y 0 0x30 0x3B 0x0290 w 2>&1\nsleep 0.5\necho \"Verificando:\"\ni2cget -y 0 0x30 0x3B w 2>&1\n'" action.permission=* action.action=allow action.pattern=*
