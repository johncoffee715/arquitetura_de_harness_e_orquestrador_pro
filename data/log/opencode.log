timestamp=2026-07-13T20:06:44.798Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 -c \"\ndata = open('/tmp/277846_original.rom', 'rb').read()\n\n# Search for '016' and '004' as part of version strings\nfor pattern in [b'016', b'004', b'000']:\n    for i in range(len(data)):\n        if data[i:i+3] == pattern:\n            context = data[max(0,i-4):i+20]\n            if all(32 <= c < 127 or c == 0 for c in context):\n                print(f'Found {pattern!r} at 0x{i:x}: {context}')\n            break  # Only first occurrence\n\n# Also look for any version-like string patterns\nimport re\nfor match in re.finditer(b'[0-9]{3}\\\\.[0-9]{3}\\\\.[0-9]{3}', data):\n    offset = match.start()\n    context = data[max(0,offset-4):offset+30]\n    print(f'Version pattern at 0x{offset:x}: {context}')\n\"" action.permission=* action.action=allow action.pattern=*
