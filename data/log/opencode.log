timestamp=2026-07-13T19:45:29.476Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 << 'PYEOF'\ndata = bytearray(open('ProVII_Lenovo_OD_enabled.rom', 'rb').read())\n\n# Buscar strings de data e versao\n# Bios Date is: 12/08/20 18:42\n# Bios Version: 016.004.000.064.015933\ndata_str = data.decode('latin-1')\nprint(\"=== Strings encontradas ===\")\n\n# Data\nidx = data_str.find('12/08/20')\nif idx >= 0:\n    print(f\"  Data em 0x{idx:05x}: {repr(data_str[idx:idx+20])}\")\n    # Mudar para 01/09/20 (dia seguinte)\n    print(f\"  Mudando: 12/08/20 18:42 -> 01/09/20 18:42\")\n    new_date = '01/09/20 18:42'\n    assert len(new_date) == len('12/08/20 18:42')\n    data[idx:idx+len(new_date)] = new_date.encode('latin-1')\n\n# Versao\nidx = data_str.find('016.')\nif idx >= 0:\n    # Mostrar contexto\n    ctx = data_str[idx:idx+30]\n    print(f\"  Versao em 0x{idx:05x}: {repr(ctx)}\")\n    # Bump: 016.004.000.064.015933 -> 016.004.000.064.015934\n    if '015933' in ctx:\n        old = '015933'\n    else:\n        # Procurar variacao\n        import re\n        m = re.search(r'(\\d{6})', data_str[idx:idx+30])\n        if m:\n            old = m.group(1)\n        else:\n            old = None\n    \n    if old:\n        new_ver = str(int(old) + 1)\n        data[idx+data_str[idx:idx+50].find(old):idx+data_str[idx:idx+50].find(old)+len(old)] = new_ver.encode()\n        print(f\"  Versao {old} -> {new_ver}\")\n\n# Salvar\nmd5 = hashlib.md5(data).hexdigest()\nopen('ProVII_Lenovo_OD_enabled.rom', 'wb').write(data)\nprint(f\"\\n  Salvo: ProVII_Lenovo_OD_enabled.rom\")\nprint(f\"  MD5: {md5}\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
