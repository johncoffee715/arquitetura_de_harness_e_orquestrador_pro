timestamp=2026-07-12T23:40:12.280Z level=INFO run=56d81d33 message=evaluated permission=bash pattern="python3 -c \"\nimport json\nwith open('/home/johncoffee/.config/heroic/sideload_apps/library.json') as f:\n    data = json.load(f)\ngames = data.get('games', [])\nprint(f'Games count: {len(games)}')\n# Check first and last few\nfor g in games[:3]:\n    print(f'  {g[\\\"app_name\\\"]} -> {g[\\\"title\\\"]}')\nprint('  ...')\nfor g in games[-2:]:\n    print(f'  {g[\\\"app_name\\\"]} -> {g[\\\"title\\\"]}')\n# Check for duplicate app_names\nnames = [g['app_name'] for g in games]\ndupes = set([n for n in names if names.count(n) > 1])\nif dupes:\n    print(f'DUPLICATE app_names: {dupes}')\nelse:\n    print('No duplicate app_names')\n\"" action.permission=* action.action=allow action.pattern=*
