timestamp=2026-07-13T20:07:01.241Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 -c \"\norig = open('/tmp/277846_original.rom', 'rb').read()\npatched = bytearray(orig)\n\n# Apply OD features and clock changes\npatched[0xd10e] = 0x01  # OD feature GFXCLK_LIMITS ON\npatched[0xd10f] = 0x01  # OD feature UCLK_MAX ON\npatched[0xd082] = 0x5c; patched[0xd083] = 0x08  # SCLK 2140\npatched[0xd3b2] = 0x5c; patched[0xd3b3] = 0x08  # MCLK max  \npatched[0xd452] = 0x5c; patched[0xd453] = 0x08  # SCLK P0\npatched[0xd454] = 0x3c; patched[0xd455] = 0x05  # MCLK P0 1340\npatched[0xd482] = 0x5c; patched[0xd483] = 0x08  # SCLK max\n\n# Update the FULL version string at 0x226\n# Original: VER016.004.000.064.015933\\x00D164070\n# Change to: VER016.004.000.064.999999\\x00D164070 (much higher build number)\nold_ver = b'016.004.000.064.015933'\nnew_ver = b'016.004.000.064.999999'\nidx = patched.find(old_ver)\nif idx >= 0:\n    print(f'Found version at 0x{idx:x}')\n    patched[idx:idx+len(old_ver)] = new_ver\nelse:\n    print('Version string not found!')\n\n# Also update the date to be clearly newer\n# Original: 12/08/20 18:42\n# New: 12/08/30 18:42 (year 2030)\nold_date = b'12/08/20 18:42'\nidx2 = patched.find(old_date)\nif idx2 >= 0:\n    print(f'Found date at 0x{idx2:x}')\n    patched[idx2:idx2+len(old_date)] = b'12/08/30 18:42'\n\nopen('/tmp/ProVII_fullver_bumped.rom', 'wb').write(patched)\nprint('Created /tmp/ProVII_fullver_bumped.rom')\n\n# Verify\nprint()\nprint('Old version:', orig[0x226:0x244])\nprint('New version:', bytes(patched[0x226:0x244]))\nprint('Old date:', orig[0x50:0x62] if orig[0x50:0x62].endswith(b'42\\x00\\x00') else 'not at 0x50')\n\"" action.permission=* action.action=allow action.pattern=*
