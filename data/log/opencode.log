timestamp=2026-07-13T20:14:06.469Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 << 'PYEOF'\nwith open('/tmp/amdvbflash_patched_norsa', 'rb') as f:\n    data = bytearray(f.read())\n\ndef file_offset(va):\n    \"\"\"Convert VA to file offset using .text section mapping\"\"\"\n    # .text: VA 0x4004a0, file offset 0x4a0\n    # So: file_offset = (VA - 0x4004a0) + 0x4a0 = VA - 0x400000\n    return va - 0x400000\n\npatches = []\n\n# ===== PATCH 1: Already done - VA 0x424486: 75 1d (jne) → eb 1d (jmp) =====\noff = file_offset(0x424486)\nassert data[off] == 0x75, f\"Expected 0x75 at 0x{off:x}, got 0x{data[off]:02x}\"\nold_val = data[off]\ndata[off] = 0xeb\nprint(f\"[1] VA 0x424486: 0x{old_val:02x} → 0x{data[off]:02x} (jne→jmp, already applied)\")\npatches.append(\"VA 0x424486: skip call 0x424314 fail check\")\n\n# ===== PATCH 2: Already done - VA 0x424714: 75 15 (jne→FAILED) → 90 90 (nop) =====\noff = file_offset(0x424714)\nassert data[off] == 0x75, f\"Expected 0x75 at 0x{off:x}, got 0x{data[off]:02x}\"\nold1, old2 = data[off], data[off+1]\ndata[off] = 0x90\ndata[off+1] = 0x90\nprint(f\"[2] VA 0x424714: {old1:02x} {old2:02x} → 90 90 (nop RSA fail check, already applied)\")\npatches.append(\"VA 0x424714: nop RSA fail check\")\n\n# ===== PATCH 3: Function 0x424314 - change fail path to return 1 =====\n# VA 0x424391: bd 00 00 00 00 (mov $0x0,%ebp) → bd 01 00 00 00 (mov $0x1,%ebp)\noff = file_offset(0x424391)\nprint(f\"[3] Checking VA 0x424391 → file offset 0x{off:x}: {data[off]:02x} {data[off+1]:02x} {data[off+2]:02x} {data[off+3]:02x} {data[off+4]:02x}\")\nassert data[off] == 0xbd, f\"Expected 0xbd at 0x{off:x}, got 0x{data[off]:02x}\"\nassert data[off+1] == 0x00, f\"Expected 0x00 at 0x{off+1:x}\"\ndata[off+1] = 0x01\nprint(f\"      → {data[off]:02x} {data[off+1]:02x} {data[off+2]:02x} {data[off+3]:02x} {data[off+4]:02x} (mov $0x1,%ebp)\")\npatches.append(\"VA 0x424391: function returns 1\")\n\n# ===== PATCH 4: ALL 8 error code 0x25 → 0x24 =====\nerror_vas = [\n    0x424494, 0x424514, 0x424551, 0x4245a4,\n    0x4245db, 0x42461d, 0x424667, 0x424737,\n]\nfor i, va in enumerate(error_vas):\n    off = file_offset(va)\n    # c7 45 XX 25 00 00 00\n    assert data[off] == 0xc7, f\"i={i} VA {va:x}: Expected 0xc7 at 0x{off:x}, got 0x{data[off]:02x}\"\n    assert data[off+3] == 0x25, f\"i={i} VA {va:x}: Expected 0x25 at 0x{off+3:x}, got 0x{data[off+3]:02x}\"\n    old = data[off+3]\n    data[off+3] = 0x24\n    print(f\"[4.{i+1}] VA 0x{va:x}: error 0x{old:02x} → 0x24\")\n    patches.append(f\"VA 0x{va:x}: err 0x25→0x24\")\n\n# ===== PATCH 5: RSA function 0x416ea5 - force return 0 =====\n# VA 0x4170b6: 89 d8 (mov %ebx,%eax) → 31 c0 (xor %eax,%eax)\noff = file_offset(0x4170b6)\nassert data[off] == 0x89 and data[off+1] == 0xd8, f\"Expected 89 d8 at 0x{off:x}, got {data[off]:02x} {data[off+1]:02x}\"\ndata[off] = 0x31\ndata[off+1] = 0xc0\nprint(f\"[5] VA 0x4170b6: 89 d8 → 31 c0 (RSA func returns 0)\")\npatches.append(\"VA 0x4170b6: RSA func returns 0\")\n\n# ===== Save =====\nwith open('/tmp/amdvbflash_patched_norsa', 'wb') as f:\n    f.write(data)\n\nimport hashlib\nprint(f\"\\n=== Summary ===\")\nprint(f\"Total patches: {len(patches)}\")\nfor p in patches:\n    print(f\"  ✓ {p}\")\nprint(f\"\\nMD5: {hashlib.md5(data).hexdigest()}\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
