timestamp=2026-07-13T17:57:00.037Z level=INFO run=007f36c8 message=evaluated permission=bash pattern="python3 -c \"\nimport json, os\nfrom collections import Counter\n\nconfig_dir = os.path.expanduser('~/.config/heroic/GamesConfig')\n\nprefixes = {}\nfor f in os.listdir(config_dir):\n    if not f.endswith('.json'):\n        continue\n    name = f[:-5]\n    with open(os.path.join(config_dir, f)) as fh:\n        data = json.load(fh)\n    cfg = data.get(name, {})\n    prefix = cfg.get('winePrefix', 'N/A')\n    prefixes.setdefault(prefix, []).append(name)\n\nprint('===== PREFIX USAGE =====')\nfor p, games in sorted(prefixes.items()):\n    print(f'\\n{p} ({len(games)} jogos):')\n    for g in sorted(games):\n        print(f'  {g}')\n\"" action.permission=* action.action=allow action.pattern=*
