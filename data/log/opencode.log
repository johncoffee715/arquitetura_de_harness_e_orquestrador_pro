timestamp=2026-07-13T18:50:53.151Z level=INFO run=047e387f message=evaluated permission=bash pattern="sudo -S bash -c '\n# Instalar script limpo\ncp /home/johncoffee/apply-gpu-patch-clean.sh /usr/local/bin/apply-gpu-patch.sh\n\n# Reativar só o apply-gpu-patch (pp_table, sem OD override)\nsystemctl enable apply-gpu-patch.service 2>&1\nsystemctl restart apply-gpu-patch.service 2>&1\n\n# Verificar\necho \"=== Servicos ativos ===\"\nsystemctl is-enabled apply-gpu-patch.service 2>/dev/null\nsystemctl is-enabled gpu-performance-daemon.service 2>/dev/null\nsystemctl is-enabled mi50-gpu-setup.service 2>/dev/null\n\necho \"=== estado GPU ===\"\ncat /sys/class/drm/card1/device/power_dpm_force_performance_level\ncat /sys/class/drm/card1/device/pp_dpm_sclk | grep \"\\*\"\ncat \"/sys/kernel/debug/dri/0000:05:00.0/amdgpu_pm_info\" 2>/dev/null | grep -E \"SCLK|VDDGFX\"\n'" action.permission=bash action.pattern="sudo *" action.action=allow
