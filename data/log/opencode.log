timestamp=2026-07-13T19:37:56.677Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 << 'PYEOF'\ndata = bytearray(open('MOONSHOT_D3600200-106_MI50patch.rom', 'rb').read())\n\n# O relatorio menciona 2 checksums: bloco legacy e bloco UEFI\n# O bloco UEFI comeca em 0x0E600 aproximadamente (onde esta o 0x0E622)\n# Vamos verificar a regiao do UEFI GOP\n\nprint(\"=== Regiao UEFI GOP (0x0E600-0x0E640) ===\")\nfor i in range(0x0E600, 0x0E640, 16):\n    hexs = ' '.join(f'{b:02x}' for b in data[i:i+16])\n    asc = ''.join(chr(b) if 32 <= b < 127 else '.' for b in data[i:i+16])\n    print(f\"  0x{i:05x}: {hexs}  |{asc}|\")\n\n# Procurar PCIR signature na regiao UEFI\nprint(\"\\n=== Procurando PCIR no UEFI ===\")\nfor i in range(0x0E000, 0x10000):\n    if data[i:i+4] == b'PCIR':\n        print(f\"  PCIR encontrado em 0x{i:05x}\")\n        # O checksum do option ROM PCIR esta em offset +16 do PCIR\n        # PCIR structure: 'PCIR' + vendor(2) + device(2) + length(2) + ...\n        # DeviceID esta em PCIR+4\n        devid = data[i+4] | (data[i+5] << 8)\n        print(f\"  DeviceID: 0x{devid:04x}\")\n        # Checksum do PCIR option ROM\n        # Option ROM checksum esta no primeiro byte do ROM header\n        # Mas o UEFI GOP ROM tem seu proprio checksum em offset 0x1A do PCIR\n        if i + 0x15 < len(data):\n            print(f\"  PCIR checksum reg: 0x{data[i+0x14]:02x} 0x{data[i+0x15]:02x}\")\n\n# Verificar checksum do option ROM inteiro\n# Option ROM padrao: checksum em offset 0, soma de todos os bytes do ROM mod 256 = 0\n# Mas UEFI option ROMs sao diferentes (PIFF checksum)\nprint(\"\\n=== Procurando outros checksums ===\")\n# Verificar se ha um checksum geral que precisa ser 0\nfor rom_start in [0x0E200, 0x0E600, 0x0E000]:\n    if rom_start < len(data):\n        # Somar 64KB a partir do start\n        end = min(rom_start + 0x10000, len(data))\n        total = sum(data[rom_start:end])\n        print(f\"  Soma 0x{rom_start:05x}-0x{end:05x}: 0x{total & 0xFF:02x} (deve ser 0x00)\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
