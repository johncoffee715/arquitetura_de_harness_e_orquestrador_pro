timestamp=2026-07-13T20:06:22.076Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 -c \"\norig = open('/tmp/277846_original.rom', 'rb').read()\npatched = bytearray(orig)\n\n# Apply our OD feature changes first (same as before)\n# OD feature flags at 0xd10e-0xd10f: turn ON GFXCLK_LIMITS and UCLK_MAX\npatched[0xd10e] = 0x01  # was 0x00\npatched[0xd10f] = 0x01  # was 0x00\n\n# SCLK max at 0xd080: 2140 MHz (0x085c)\npatched[0xd082] = 0x5c  # was 0xa4\npatched[0xd083] = 0x08  # was 0x06\n\n# MCLK max at 0xd3b0: 1340 MHz (0x053c)\npatched[0xd3b2] = 0x5c  # was 0x00\npatched[0xd3b3] = 0x08  # was 0x00\n\n# SCLK P0 at 0xd450: 2140 MHz\npatched[0xd452] = 0x5c  # was 0xa4\npatched[0xd453] = 0x08  # was 0x06\n\n# MCLK P0 at 0xd454: 1340 MHz\npatched[0xd454] = 0x3c  # was 0xcc (0x0cc3 = 3267 -> 0x053c = 1340)\npatched[0xd455] = 0x05  # was 0x03\n\n# SCLK max at 0xd480: 2140 MHz\npatched[0xd482] = 0x5c  # was 0xa4\npatched[0xd483] = 0x08  # was 0x06\n\n# Bump version to something MUCH higher (999999 instead of 015933)\n# Version at 0x230: '0.064.015933'\npatched[0x230:0x244] = b'0.064.999999\\x00D164070'\n\n# Also update the AMD part number at 0x24 ('8f' -> '??')\n# Actually the '8f' vs '4f' difference at 0x24 - let me check what it is\n# Original had 0x8f at 0x24, patched had 0x4f at 0x24\n# Looking at the original: 'M\\x8f<\\x8e...' \n# The difference was at 0x24: original had 0x8f, patched had 0x4f\n# Let me keep original value to minimize changes\n# Actually, looking at the diff earlier: offset 0x24 changed from 8f to 4f\n# And 0x30 changed from ' 761295520...' to ' 7612955\\xb05Uj...'\n# These might be SSID/SVID related or other identifiers\n# Let me just bump the version and try\n\n# Date: make it much newer to pass check\npatched[0x50:0x62] = b'12/08/25 18:42\\x00\\x00'\n\nopen('/tmp/ProVII_version_bumped.rom', 'wb').write(patched)\nprint('Created /tmp/ProVII_version_bumped.rom')\nimport hashlib\nprint('MD5:', hashlib.md5(bytes(patched)).hexdigest())\n\" 2>&1" action.permission=* action.action=allow action.pattern=*
