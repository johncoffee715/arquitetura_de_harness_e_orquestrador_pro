timestamp=2026-07-13T19:13:28.329Z level=INFO run=fe8d3ba5 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport struct, shutil\n\nstock = '/mnt/dados/gpu-fw/mi50/backups/pp_table_20260710_172626.bin'\ndst = '/mnt/dados/gpu-fw/mi50/pp_table_patches/pp_table_2140mhz_v2.bin'\n\nshutil.copy2(stock, dst)\ndata = bytearray(open(dst, 'rb').read())\n\n# SCLK: 1700 → 2140 MHz\nfor old, new in [(1700, 2140)]:\n    old_b = struct.pack('<H', old)\n    new_b = struct.pack('<H', new)\n    idx = 0\n    while True:\n        idx = data.find(old_b, idx)\n        if idx == -1: break\n        data[idx:idx+2] = new_b\n        idx += 2\n\n# MCLK: 1000 → 1340 MHz\nold_b = struct.pack('<H', 1000)\nnew_b = struct.pack('<H', 1340)\nidx = 0\nwhile True:\n    idx = data.find(old_b, idx)\n    if idx == -1: break\n    data[idx:idx+2] = new_b\n    idx += 2\n\n# TDP: 190 → 350W\nold_b = struct.pack('<H', 190)\nnew_b = struct.pack('<H', 350)\nidx = 0\nwhile True:\n    idx = data.find(old_b, idx)\n    if idx == -1: break\n    data[idx:idx+2] = new_b\n    idx += 2\n\n# TDC: 300A\ndata[0x4A:0x4C] = struct.pack('<H', 300)\n\nopen(dst, 'wb').write(data)\nprint(f\"pp_table 2140 MHz criada: {dst}\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
