timestamp=2026-07-12T23:40:12.283Z level=INFO run=56d81d33 message=evaluated permission=bash pattern="python3 -c \"\nimport json, os, glob\n\n# Load library app_names\nwith open('/home/johncoffee/.config/heroic/sideload_apps/library.json') as f:\n    lib = json.load(f)\nlib_names = {g['app_name'] for g in lib['games']}\n\n# Load gamesconfig files\ncfg_dir = os.path.expanduser('~/.config/heroic/GamesConfig')\ncfg_names = set()\nfor f in glob.glob(f'{cfg_dir}/*.json'):\n    name = os.path.splitext(os.path.basename(f))[0]\n    cfg_names.add(name)\n\nmissing_in_cfg = lib_names - cfg_names\nextra_in_cfg = cfg_names - lib_names\n\nprint(f'Library app_names: {len(lib_names)}')\nprint(f'GamesConfig files: {len(cfg_names)}')\nprint(f'Missing GamesConfig for library entries: {missing_in_cfg if missing_in_cfg else \\\"NONE\\\"}')\nprint(f'Extra GamesConfig files (no library entry): {extra_in_cfg if extra_in_cfg else \\\"NONE\\\"}')\n\nif missing_in_cfg:\n    print('\\\\n--- Missing GamesConfig ---')\n    for n in missing_in_cfg:\n        title = next((g['title'] for g in lib['games'] if g['app_name'] == n), '?')\n        print(f'  {n} ({title})')\n\"" action.permission=* action.action=allow action.pattern=*
