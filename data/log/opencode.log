timestamp=2026-07-13T19:36:27.016Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 << 'PYEOF'\ndata = open('MOONSHOT_D3600200-106_MI50.rom', 'rb').read()\nprint(f\"Tamanho: {len(data)} bytes\")\n\n# Offsets do relatorio: 0x000AE, 0x002C6, 0x0E622\n# Patchado = 0xA1 (66A1 = MI50), Original = 0xAF (66AF = consumer VII)\noffsets = [0x000AE, 0x002C6, 0x0E622]\nprint()\nfor off in offsets:\n    val = data[off]\n    if val == 0xA1:\n        status = \"PATCHADO (66A1 = MI50) ✓\"\n    elif val == 0xAF:\n        status = \"ORIGINAL (66AF = consumer VII)\"\n    else:\n        status = f\"DESCONHECIDO (0x{val:02x})\"\n    print(f\"  0x{off:05x}: 0x{val:02x} — {status}\")\n\n# Strings de identificacao\nprint()\nimport subprocess\nresult = subprocess.run(['strings', 'MOONSHOT_D3600200-106_MI50.rom'], capture_output=True, text=True)\nfor line in result.stdout.split('\\n'):\n    if any(x in line for x in ['113-D', 'ATOMBIOSBK', 'VEGA20', 'D36', 'MOONSHOT', 'SSID', 'config.h', 'CU', 'HI']):\n        print(f\"  {line}\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
