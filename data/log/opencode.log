timestamp=2026-07-13T19:36:36.503Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport struct, shutil\n\nsrc = 'MOONSHOT_D3600200-106_MI50.rom'\ndst = 'MOONSHOT_D3600200-106_MI50patch.rom'\n\nshutil.copy2(src, dst)\ndata = bytearray(open(dst, 'rb').read())\n\n# 3 patches: 0xAF → 0xA1 (66AF = Radeon VII consumer → 66A1 = MI50)\npatches = [\n    (0x000AE, \"bootstrap init code\"),\n    (0x002C6, \"legacy PCIR DeviceID\"),\n    (0x0E622, \"UEFI GOP PCIR DeviceID — critico para display\"),\n]\n\nprint(\"=== Patching MOONSHOT → MI50 ===\")\nfor offset, desc in patches:\n    old = data[offset]\n    data[offset] = 0xA1\n    print(f\"  0x{offset:05x}: 0x{old:02x} → 0xA1  ({desc})\")\n\n# Recalcular checksum do bloco legacy (0x00-0xFF)\n# ATOM BIOS checksum = soma de todos os bytes mod 256, deve dar 0\nchecksum_offset = 0x21  # offset onde fica o byte de checksum\nchecksum = sum(data[0:checksum_offset]) + sum(data[checksum_offset+1:0x100])\ndata[checksum_offset] = (256 - (checksum & 0xFF)) & 0xFF\nprint(f\"  Checksum legacy recalculado: 0x{data[checksum_offset]:02x}\")\n\n# Escrever\nopen(dst, 'wb').write(data)\n\n# Verificar\nimport hashlib\nmd5 = hashlib.md5(data).hexdigest()\nprint(f\"\\n  Salvo: {dst}\")\nprint(f\"  Tamanho: {len(data)} bytes\")\nprint(f\"  MD5: {md5}\")\n\n# Confirmar patches\nprint(f\"\\n=== Verificacao ===\")\nfor offset, desc in patches:\n    val = data[offset]\n    status = \"OK ✓\" if val == 0xA1 else \"ERRO!\"\n    print(f\"  0x{offset:05x}: 0x{val:02x} — {status}\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
