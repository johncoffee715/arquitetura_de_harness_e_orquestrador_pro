timestamp=2026-07-12T23:45:48.843Z level=INFO run=1c08adfc message=evaluated permission=bash pattern="cat > /home/johncoffee/gpu-performance-daemon-v2.sh << 'SCRIPT'\n#!/bin/bash\n# gpu-performance-daemon.sh — Sobe clock sob carga sem causar flicker\n# v2: 3 níveis de clock — idle/desktop/turbo — pra evitar GFX timeouts no desktop\n\nPERF=\"/sys/class/drm/card1/device/power_dpm_force_performance_level\"\nSCLK=\"/sys/class/drm/card1/device/pp_dpm_sclk\"\nBUSY=\"/sys/class/drm/card1/device/gpu_busy_percent\"\n\nLOW_LEVEL=\"0\"        #  859 MHz — idle\nMID_LEVEL=\"7\"        # 1654 MHz — desktop (stock-like, estável)\nHIGH_LEVEL=\"8\"       # 2120 MHz — turbo OC (só >70% carga)\n\nMID_THRESHOLD=15     # % pra subir pra mid clock\nHIGH_THRESHOLD=70    # % pra subir pra max clock\nIDLE_THRESHOLD=5     # % pra considerar idle\nPOLL_INTERVAL=3      # segundos\nIDLE_CYCLES=10       # ~30s idle antes de reduzir\n\necho \"manual\" > \"$PERF\" 2>/dev/null\necho \"$LOW_LEVEL\" > \"$SCLK\" 2>/dev/null\nlast_clock=\"$LOW_LEVEL\"\nidle_count=0\n\nlogger \"[gpu-perf] Daemon v2 iniciado (manual, poll=${POLL_INTERVAL}s)\"\n\nwhile true; do\n    load=$(cat \"$BUSY\" 2>/dev/null || echo 0)\n\n    if [ \"$load\" -ge \"$HIGH_THRESHOLD\" ]; then\n        # ─── Carga pesada → turbo 2120 MHz ───\n        if [ \"$last_clock\" != \"$HIGH_LEVEL\" ]; then\n            echo \"$HIGH_LEVEL\" > \"$SCLK\" 2>/dev/null\n            last_clock=\"$HIGH_LEVEL\"\n            logger \"[gpu-perf] ↑↑ turbo ${HIGH_LEVEL} (carga ${load}%)\"\n        fi\n        idle_count=0\n\n    elif [ \"$load\" -ge \"$MID_THRESHOLD\" ]; then\n        # ─── Carga moderada (desktop) → mid 1654 MHz ───\n        if [ \"$last_clock\" != \"$MID_LEVEL\" ]; then\n            echo \"$MID_LEVEL\" > \"$SCLK\" 2>/dev/null\n            last_clock=\"$MID_LEVEL\"\n            logger \"[gpu-perf] ↑ mid ${MID_LEVEL} (carga ${load}%)\"\n        fi\n        idle_count=0\n\n    elif [ \"$load\" -le \"$IDLE_THRESHOLD\" ]; then\n        idle_count=$((idle_count + 1))\n        if [ \"$idle_count\" -ge \"$IDLE_CYCLES\" ] && [ \"$last_clock\" != \"$LOW_LEVEL\" ]; then\n            echo \"$LOW_LEVEL\" > \"$SCLK\" 2>/dev/null\n            last_clock=\"$LOW_LEVEL\"\n            logger \"[gpu-perf] ↓ clock ${LOW_LEVEL} (idle ${load}%)\"\n            idle_count=0\n        fi\n    else\n        idle_count=0\n    fi\n\n    sleep \"$POLL_INTERVAL\"\ndone\nSCRIPT" action.permission=* action.action=allow action.pattern=*
