timestamp=2026-07-13T19:38:55.620Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 << 'PYEOF'\n# Comparar Pro VII Lenovo (277846.rom) vs MOONSHOT (MOONSHOT_D3600200-106_MI50.rom original)\n# Procurar a regiao de OD features (offset 0x00AC na pp_table do relatorio)\n\nproVII = open('277846.rom', 'rb').read()\nmoon = open('MOONSHOT_D3600200-106_MI50.rom', 'rb').read()\n\nprint(f\"Pro VII: {len(proVII)} bytes\")\nprint(f\"MOONSHOT: {len(moon)} bytes\")\nprint()\n\n# O relatorio diz que OD features estao em 0x00AC na pp_table\n# Mas na VBIOS, a pp_table esta em offset diferente\n# Vamos procurar o padrao mencionado: 00 00 00 00 01 01 00 00 (Pro VII OD off)\n# vs o que o MOONSHOT teria (01 00 01 00 01 01 = OD on)\n\n# Padrao do relatorio Pro VII: 00 00 00 00 01 01 00 00 00 00 00 00 00 00 01\n# (offset 0x00AC na pp_table)\npattern_proVII = bytes([0x00, 0x00, 0x00, 0x00, 0x01, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01])\n\nprint(\"=== Procurando padrao OD features Pro VII na VBIOS ===\")\nfor i in range(len(proVII) - len(pattern_proVII)):\n    if proVII[i:i+len(pattern_proVII)] == pattern_proVII:\n        print(f\"  Encontrado em 0x{i:05x}\")\n        # Mostrar 32 bytes ao redor\n        start = max(0, i-4)\n        end = min(len(proVII), i+20)\n        hexs = ' '.join(f'{b:02x}' for b in proVII[start:end])\n        print(f\"  Contexto: {hexs}\")\n\nprint()\nprint(\"=== Procurando mesmo offset no MOONSHOT ===\")\n# Procurar a mesma regiao no MOONSHOT\nfor i in range(len(moon) - len(pattern_proVII)):\n    # Procurar por algo similar mas com OD on: 01 00 01 00 01 01\n    if moon[i:i+6] == bytes([0x01, 0x00, 0x01, 0x00, 0x01, 0x01]):\n        if all(moon[i+6:i+15] == proVII[j+6:j+15] for j in [i] if j < len(proVII)):\n            print(f\"  Possivel OD on em 0x{i:05x}\")\n            start = max(0, i-4)\n            end = min(len(moon), i+20)\n            hexs = ' '.join(f'{b:02x}' for b in moon[start:end])\n            print(f\"  Contexto: {hexs}\")\n\n# Abordagem alternativa: procurar diffs na regiao 0x00-0x200 entre Pro VII e MOONSHOT\nprint()\nprint(\"=== Diffs Pro VII vs MOONSHOT nos primeiros 1024 bytes ===\")\nfor i in range(min(1024, len(proVII), len(moon))):\n    if proVII[i] != moon[i]:\n        print(f\"  0x{i:05x}: ProVII=0x{proVII[i]:02x} MOON=0x{moon[i]:02x}\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
