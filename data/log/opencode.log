timestamp=2026-07-13T19:24:24.143Z level=INFO run=005dc7fd message=evaluated permission=external_directory pattern="/mnt/win1/123 tranqueiras e projetos/projeto bios mod/bios mi50/*" action.permission=external_directory action.action=allow action.pattern=*
timestamp=2026-07-13T19:24:24.144Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 << 'PYEOF'\n# Comparar Pro VII Lenovo (277846.rom, D1640700) vs Pro VII AMD WS (AMD.RadeonProVII.16384.200818.rom, D1640600)\n# Ambas 512KB, mesma familia, apenas config diferente\n\nlenovo = open('277846.rom', 'rb').read()\namdws = open('AMD.RadeonProVII.16384.200818.rom', 'rb').read()\n\nprint(f\"Lenovo D1640700: {len(lenovo)} bytes\")\nprint(f\"AMD WS D1640600: {len(amdws)} bytes\")\nprint()\n\ndiffs = []\nfor i in range(len(lenovo)):\n    if lenovo[i] != amdws[i]:\n        diffs.append((i, lenovo[i], amdws[i]))\n\nprint(f\"Total de bytes diferentes: {len(diffs)}\")\nprint()\n\n# Agrupar\nregions = []\nif diffs:\n    start = diffs[0][0]\n    last = start\n    for offset, l, a in diffs[1:]:\n        if offset <= last + 4:\n            last = offset\n        else:\n            regions.append((start, last))\n            start = offset\n            last = offset\n    regions.append((start, last))\n\nprint(f\"Regioes diferentes: {len(regions)}\")\nprint()\n\nfor start, end in regions:\n    size = end - start + 1\n    l_bytes = lenovo[start:min(end+1, start+32)]\n    a_bytes = amdws[start:min(end+1, start+32)]\n    l_hex = ' '.join(f'{b:02x}' for b in l_bytes)\n    a_hex = ' '.join(f'{b:02x}' for b in a_bytes)\n    l_ascii = ''.join(chr(b) if 32 <= b < 127 else '.' for b in l_bytes)\n    a_ascii = ''.join(chr(b) if 32 <= b < 127 else '.' for b in a_bytes)\n    print(f\"0x{start:05x} ({size:3d}B)\")\n    print(f\"  Lenovo: {l_hex}  |{l_ascii}|\")\n    print(f\"  AMD WS: {a_hex}  |{a_ascii}|\")\n    print()\nPYEOF" action.permission=* action.action=allow action.pattern=*
