timestamp=2026-07-13T12:03:12.155Z level=INFO run=04d92069 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport struct, shutil, os\n\n# 1. Create patched pp_table: 2140 MHz SCLK max\nsrc = '/mnt/dados/gpu-fw/mi50/pp_table_patches/pp_table_overclocked_final.bin'\ndst = '/mnt/dados/gpu-fw/mi50/pp_table_patches/pp_table_2140mhz.bin'\n\nshutil.copy2(src, dst)\ndata = bytearray(open(dst, 'rb').read())\n\npatches = [\n    (0x034a, 2140),\n    (0x03f2, 2140),\n    (0x042a, 2140),\n]\n\nprint(\"=== Patches pp_table: 2120 → 2140 MHz ===\")\nfor offset, freq in patches:\n    old = struct.unpack('<H', data[offset:offset+2])[0]\n    data[offset:offset+2] = struct.pack('<H', freq)\n    new = struct.unpack('<H', data[offset:offset+2])[0]\n    print(f'  0x{offset:04x}: {old} MHz → {new} MHz')\n\nopen(dst, 'wb').write(data)\nprint(f'\\nSalvo: {dst} ({len(data)} bytes)')\n\n# 2. Create a convenience script for the user to run\napply_script = '/home/johncoffee/apply-2140mhz.sh'\nwith open(apply_script, 'w') as f:\n    f.write('''#!/bin/bash\n# apply-2140mhz.sh — Aplica pp_table 2140 MHz +50mV VDDC\n# Execute como root: sudo bash apply-2140mhz.sh\n\nset -e\n\nPP_SYS=\"/sys/class/drm/card1/device/pp_table\"\nOC_FILE=\"/mnt/dados/gpu-fw/mi50/pp_table_patches/pp_table_2140mhz.bin\"\nOD=\"/sys/class/drm/card1/device/pp_od_clk_voltage\"\nSCLK=\"/sys/class/drm/card1/device/pp_dpm_sclk\"\n\necho \"[1/4] Carregando pp_table 2140 MHz...\"\ncat \"$OC_FILE\" > \"$PP_SYS\"\necho \"  OK\"\n\necho \"[2/4] Aplicando +50mV VDDC + override SCLK 2140 MHz...\"\necho \"s 8 2140\" > \"$OD\"\necho \"v 50\" > \"$OD\"\necho \"c\" > \"$OD\"\necho \"  OK\"\n\necho \"[3/4] Restartando daemon de performance...\"\nsystemctl restart gpu-performance-daemon.service\necho \"  OK\"\n\necho \"[4/4] Verificando...\"\ncat /sys/class/drm/card1/device/pp_dpm_sclk\necho \"\"\necho \"  +50mV aplicado. Nível 8 = 2140 MHz.\"\necho \"\"\necho \"Para testar: jogue NFS Rivals e monitore com:\"\necho \"  watch -n 1 cat /sys/class/drm/card1/device/pp_dpm_sclk\"\necho \"  watch -n 1 cat /sys/class/drm/card1/device/hwmon/hwmon*/temp1_input\"\n''')\n\nos.chmod(apply_script, 0o755)\nprint(f'\\nScript helper: {apply_script}')\nPYEOF" action.permission=* action.action=allow action.pattern=*
