timestamp=2026-07-13T18:25:14.550Z level=INFO run=92cd5172 message=evaluated permission=bash pattern="cat > /home/johncoffee/gpu-performance-daemon-v2.sh << 'SCRIPT'\n#!/bin/bash\n# gpu-performance-daemon.sh v3 — Clock management pra MI50/Radeon Pro VII\n# Modo \"high\" força o clock alvo; daemon reduz pra idle quando sem carga\n\nPERF=\"/sys/class/drm/card1/device/power_dpm_force_performance_level\"\nSCLK=\"/sys/class/drm/card1/device/pp_dpm_sclk\"\nMCLK=\"/sys/class/drm/card1/device/pp_dpm_mclk\"\nBUSY=\"/sys/class/drm/card1/device/gpu_busy_percent\"\n\nSCLK_HIGH=\"8\"\nMCLK_HIGH=\"2\"\nIDLE_THRESHOLD=5\nPOLL_INTERVAL=3\nIDLE_CYCLES=20\n\necho \"high\" > \"$PERF\" 2>/dev/null\necho \"$SCLK_HIGH\" > \"$SCLK\" 2>/dev/null\necho \"$MCLK_HIGH\" > \"$MCLK\" 2>/dev/null\n\nidle_count=0\nlogger \"[gpu-perf] Daemon v3 iniciado (high, SCLK level=${SCLK_HIGH})\"\n\nwhile true; do\n    load=$(cat \"$BUSY\" 2>/dev/null || echo 0)\n\n    if [ \"$load\" -le \"$IDLE_THRESHOLD\" ]; then\n        idle_count=$((idle_count + 1))\n        if [ \"$idle_count\" -ge \"$IDLE_CYCLES\" ]; then\n            echo \"auto\" > \"$PERF\" 2>/dev/null\n            logger \"[gpu-perf] down idle ${load}% — voltando pra auto\"\n        fi\n    else\n        if [ \"$idle_count\" -ge \"$IDLE_CYCLES\" ]; then\n            echo \"high\" > \"$PERF\" 2>/dev/null\n            echo \"$SCLK_HIGH\" > \"$SCLK\" 2>/dev/null\n            echo \"$MCLK_HIGH\" > \"$MCLK\" 2>/dev/null\n            logger \"[gpu-perf] up carga ${load}% — high mode\"\n        fi\n        idle_count=0\n    fi\n\n    sleep \"$POLL_INTERVAL\"\ndone\nSCRIPT" action.permission=* action.action=allow action.pattern=*
