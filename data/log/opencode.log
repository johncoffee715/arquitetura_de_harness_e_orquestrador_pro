timestamp=2026-07-13T21:29:21.027Z level=INFO run=549d3c96 message=evaluated permission=bash pattern="python3 << 'EOF'\nimport hashlib, shutil, os\n\n# Use the original 512KB ROM (this is the stock working VBIOS)\nsrc = '/mnt/win1/123 tranqueiras e projetos/projeto bios mod/bios mi50/277846.rom'\ndst = '/home/johncoffee/277846_original.rom'\n\nshutil.copy2(src, dst)\nprint(f\"Copied: {src} -> {dst}\")\n\nwith open(dst, 'rb') as f:\n    data = f.read()\nprint(f\"Size: {len(data)} bytes\")\nprint(f\"MD5: {hashlib.md5(data).hexdigest()}\")\nprint(f\"Magic: {data[0]:02x} {data[1]:02x}\")\n\n# Verify it's a valid AMD VBIOS\nif data[0] == 0x55 and data[1] == 0xaa:\n    print(\"✓ Valid VBIOS signature (55 AA)\")\nelse:\n    print(\"✗ Invalid signature!\")\n\n# Check chip ID string for GD25Q80C\nfor i in range(0, len(data) - 10):\n    if data[i:i+8] == b'GD25Q80C':\n        print(f\"✓ Found GD25Q80C string at offset 0x{i:x}\")\n        break\n    if data[i:i+8] == b'GD25Q80' or data[i:i+7] == b'GD25Q80':\n        print(f\"Found GD25Q80 variant at offset 0x{i:x}: {data[i:i+12]}\")\n        break\nEOF" action.permission=bash action.pattern="python3 *" action.action=allow
timestamp=2026-07-13T21:29:25.478Z level=INFO run=549d3c96 message=evaluated permission=bash pattern="python3 << 'EOF'\n# EZP2019+ is known as USB ID 1fc8:310b (www.zhifengsoft.com WinUSBComm)\n# It's a specialized SPI flash programmer\n# Common software options on Linux:\n# 1. flashrom - only if it has a programmer driver for this device  \n# 2. EZP_Soft (Windows) via Wine\n# 3. Custom Python with pyusb/libftdi\n\n# For GD25Q80C (8 Mbit = 1 MB):\n# - Standard SPI flash, 8-pin SOIC package\n# - 3.3V operation\n# - Supports standard SPI commands: 0x03 (read), 0x02 (program), 0x20 (sector erase), etc.\n\nprint(\"EZP2019+ (1fc8:310b) detected\")\nprint(\"GD25Q80C: 1MB SPI Flash, SOIC-8, 3.3V\")\nprint(\"\")\nprint(\"Connection methods:\")\nprint(\"1. SOP8 test clip (in-circuit) - clip onto chip on GPU PCB\")\nprint(\"2. Desolder and use ZIF socket - more reliable\")\nprint(\"\")\nprint(\"EZP2019+ ZIF socket mapping for SOP8:\")\nprint(\"  Socket Pin 1 -> Chip Pin 1 (CS#)\")\nprint(\"  Socket Pin 2 -> Chip Pin 8 (VCC)\") \nprint(\"  Socket Pin 3 -> Chip Pin 7 (HOLD#)\")\nprint(\"  Socket Pin 4 -> Chip Pin 6 (CLK)\")\nprint(\"  Socket Pin 5 -> Chip Pin 5 (DI/SI)\")\nprint(\"  Socket Pin 6 -> Chip Pin 4 (GND)\")\nprint(\"  Socket Pin 7 -> Chip Pin 3 (WP#)\")\nprint(\"  Socket Pin 8 -> Chip Pin 2 (DO/SO)\")\nprint(\"\")\nprint(\"WARNING: GD25Q80C is 3.3V! EZP2019+ usually auto-detects voltage\")\nprint(\"but verify the programmer is set to 3.3V before connecting!\")\nEOF" action.permission=bash action.pattern="python3 *" action.action=allow
