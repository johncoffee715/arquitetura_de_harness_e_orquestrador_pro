timestamp=2026-07-12T23:25:41.682Z level=INFO run=1ace15a5 message=evaluated permission=bash pattern="cat << 'PYEOF' > /tmp/configure_launchers.py\nimport json, os, sqlite3, hashlib, shutil\n\n# === GAME DATABASE ===\n# Format: (title, exe_path, folder_path, notes)\ngames_win1 = [\n    (\"BioShock Infinite\", \"/mnt/win1/games/BioShock Infinite/Binaries/Win32/BioShockInfinite.exe\"),\n    (\"Bloodborne\", \"/mnt/win1/games/Bloodborne/Bloodborne.exe\"),\n    (\"Bloodstained - Ritual of the Night\", \"/mnt/win1/games/Bloodstained - Ritual of the Night/BloodstainedRotN.exe\"),\n    (\"Devil May Cry 5\", \"/mnt/win1/games/Devil May Cry 5/DevilMayCry5.exe\"),\n    (\"ELDEN RING NIGHTREIGN\", \"/mnt/win1/games/ELDEN RING NIGHTREIGN/Game/nightreign.exe\"),\n    (\"God of War Ragnarok\", \"/mnt/win1/games/God of War Ragnarok/GoWR.exe\"),\n    (\"Lies of P\", \"/mnt/win1/games/Lies of P/LOP.exe\"),\n    (\"Middle Earth Shadow of Mordor GOTY\", \"/mnt/win1/games/Middle Earth Shadow of Mordor GOTY/x64/ShadowOfMordor.exe\"),\n    (\"Ninja Gaiden 4\", \"/mnt/win1/games/Ninja Gaiden 4/NINJAGAIDEN4-Steam.exe\"),\n    (\"Silent Hill f\", \"/mnt/win1/games/Silent Hill f/SHf.exe\"),\n    (\"Tekken 8\", \"/mnt/win1/games/Tekken 8/TEKKEN 8.exe\"),\n    (\"The House of the Dead 2 Remake\", \"/mnt/win1/games/The House of the Dead 2 Remake/THE HOUSE OF THE DEAD 2 Remake.exe\"),\n    (\"The Last of Us Part II Remastered\", \"/mnt/win1/games/The Last of Us Part II Remastered/tlou-ii-l.exe\"),\n]\n\ngames_win2 = [\n    (\"Battlefield 1\", \"/mnt/win2/games/Battlefield 1/bf1.exe\"),\n    (\"BioShock 2 Remastered\", \"/mnt/win2/games/BioShock 2 Remastered/Build/Final/Bioshock2HD.exe\"),\n    (\"BioShock Remastered\", \"/mnt/win2/games/BioShock Remastered/Build/Final/BioshockHD.exe\"),\n    (\"Castlevania Lords of Shadow 2\", \"/mnt/win2/games/Castlevania Lords of Shadow 2/bin/CLOS2.exe\"),\n    (\"Castlevania - Lords of Shadow UE\", \"/mnt/win2/games/Castlevania - Lords of Shadow UE/bin/CastlevaniaLoSUE.exe\"),\n    (\"Crysis 2\", \"/mnt/win2/games/Crytek/Crysis 2/bin32/Crysis2.exe\"),\n    (\"Crysis 3\", \"/mnt/win2/games/Crytek/Crysis 3/Bin32/Crysis3.exe\"),\n    (\"Devil May Cry HD Collection\", \"/mnt/win2/games/Devil May Cry HD Collection/dmcLauncher.exe\"),\n    (\"Dying Light\", \"/mnt/win2/games/Dying Light/DyingLightGame.exe\"),\n    (\"Forza Horizon 6\", \"/mnt/win2/games/Forza Horizon 6/forzahorizon6.exe\"),\n    (\"God of War\", \"/mnt/win2/games/God of War/GoW.exe\"),\n    (\"Gungrave G.O.R.E\", \"/mnt/win2/games/Gungrave G.O.R.E/GunGraveGore.exe\"),\n    (\"Mad Max\", \"/mnt/win2/games/Mad Max/AVAMain.exe\"),\n    (\"Mafia II\", \"/mnt/win2/games/Mafia II/pc/mafia2.exe\"),\n    (\"Marvel's Spider-Man 2\", \"/mnt/win2/games/Marvel's Spider-Man 2/Spider-Man2.exe\"),\n    (\"Metro 2033 Redux\", \"/mnt/win2/games/Metro 2033 Redux/Metro2033Redux/metro.exe\"),\n    (\"Metro Exodus\", \"/mnt/win2/games/Metro Exodus/MetroExodus.exe\"),\n    (\"Metro Last Light Redux\", \"/mnt/win2/games/Metro Last Light Redux/metro.exe\"),\n    (\"Need for Speed Most Wanted\", \"/mnt/win2/games/Need for Speed Most Wanted/NFS13.exe\"),\n    (\"Need for Speed - Rivals\", \"/mnt/win2/games/Need for Speed - Rivals/NFS14.exe\"),\n    (\"RESIDENT EVIL 2\", \"/mnt/win2/games/RESIDENT EVIL 2/re2.exe\"),\n    (\"Resident Evil 3\", \"/mnt/win2/games/Resident Evil 3/re3.exe\"),\n    (\"Resident Evil 6\", \"/mnt/win2/games/Resident Evil 6/BH6.exe\"),\n    (\"Ryse - Son of Rome\", \"/mnt/win2/games/Ryse - Son of Rome/Bin64/Ryse.exe\"),\n    (\"Sekiro Shadows Die Twice\", \"/mnt/win2/games/Sekiro Shadows Die Twice/sekiro.exe\"),\n    (\"Silver Night Crusaders\", \"/mnt/win2/games/Silver_Night_Crusaders_[v1.1]/Silver_Night's_Crusaders.exe\"),\n    (\"Star Wars Jedi Fallen Order\", \"/mnt/win2/games/Star Wars Jedi Fallen Order/SwGame/Binaries/Win64/starwarsjedifallenorder.exe\"),\n    (\"The Witcher 3 Wild Hunt\", \"/mnt/win2/games/The Witcher 3 Wild Hunt/bin/x64/witcher3.exe\"),\n]\n\nall_games = games_win1 + games_win2\n\n# === GENERATE UNIQUE APP NAMES ===\ndef make_app_name(title):\n    h = hashlib.md5(title.encode()).hexdigest()[:20]\n    return f\"game_{h}\"\n\ndef slugify(title):\n    s = title.lower().replace(\"'\", \"\").replace(\".\", \"\")\n    s = s.replace(\" \", \"-\").replace(\"--\", \"-\").strip(\"-\")\n    s = \"\".join(c for c in s if c.isalnum() or c == '-')\n    return s\n\n# === HEROIC CONFIG ===\nHEROIC_SIDELOAD = os.path.expanduser(\"~/.config/heroic/sideload_apps/library.json\")\nHEROIC_GAMESCONFIG = os.path.expanduser(\"~/.config/heroic/GamesConfig\")\nHEROIC_PREFIXES = os.path.expanduser(\"~/Games/Heroic/Prefixes\")\nPROTON_BIN = \"/home/johncoffee/.config/heroic/tools/proton/GE-Proton-latest/proton\"\n\n# Read existing sideload library\nexisting_apps = set()\ntry:\n    with open(HEROIC_SIDELOAD) as f:\n        existing = json.load(f)\n        for g in existing.get(\"games\", []):\n            existing_apps.add(g[\"app_name\"])\nexcept:\n    existing = {\"games\": []}\n\nprint(f\"Existing Heroic sideload games: {len(existing_apps)}\")\n\n# Build game entries\ngame_entries = []\nfor title, exe in all_games:\n    folder = os.path.dirname(exe)\n    app_name = make_app_name(title)\n    game_entries.append({\n        \"runner\": \"sideload\",\n        \"app_name\": app_name,\n        \"title\": title,\n        \"install\": {\n            \"executable\": exe,\n            \"platform\": \"Windows\",\n            \"is_dlc\": False\n        },\n        \"folder_name\": folder,\n        \"art_cover\": \"\",\n        \"is_installed\": True,\n        \"art_square\": \"\",\n        \"canRunOffline\": True,\n        \"browserUrl\": \"\",\n        \"customUserAgent\": \"\",\n        \"launchFullScreen\": False\n    })\n\n# Merge with existing (keep existing, add new)\nexisting_titles = {g[\"title\"].lower() for g in existing.get(\"games\", [])}\nnew_count = 0\nfor entry in game_entries:\n    if entry[\"title\"].lower() not in existing_titles:\n        existing[\"games\"].append(entry)\n        existing_titles.add(entry[\"title\"].lower())\n        new_count += 1\n\nprint(f\"New Heroic games to add: {new_count}\")\n\n# Write sideload library\nos.makedirs(os.path.dirname(HEROIC_SIDELOAD), exist_ok=True)\nwith open(HEROIC_SIDELOAD, \"w\") as f:\n    json.dump(existing, f, indent=2)\nprint(f\"Written: {HEROIC_SIDELOAD}\")\n\n# Generate GamesConfig for each game\nconfig_template = {\n    \"autoInstallDxvk\": True,\n    \"autoInstallDxvkNvapi\": True,\n    \"autoInstallVkd3d\": True,\n    \"preferSystemLibs\": False,\n    \"enableEsync\": True,\n    \"enableMsync\": False,\n    \"enableFsync\": True,\n    \"enableWineWayland\": False,\n    \"enableHDR\": False,\n    \"enableWoW64\": False,\n    \"nvidiaPrime\": False,\n    \"enviromentOptions\": [],\n    \"wrapperOptions\": [],\n    \"showFps\": True,\n    \"showMangohud\": True,\n    \"useGameMode\": False,\n    \"battlEyeRuntime\": True,\n    \"eacRuntime\": True,\n    \"language\": \"\",\n    \"beforeLaunchScriptPath\": \"\",\n    \"afterLaunchScriptPath\": \"\",\n    \"verboseLogs\": True,\n    \"advertiseAvxForRosetta\": False,\n    \"enableQuickSavesMenu\": False,\n    \"wineVersion\": {\n        \"bin\": PROTON_BIN,\n        \"name\": \"GE-Proton-latest\",\n        \"type\": \"proton\"\n    },\n    \"winePrefix\": os.path.join(HEROIC_PREFIXES, \"shared\"),\n    \"wineCrossoverBottle\": \"Heroic\"\n}\n\ngamesconfig_count = 0\nfor title, exe in all_games:\n    app_name = make_app_name(title)\n    config_path = os.path.join(HEROIC_GAMESCONFIG, f\"{app_name}.json\")\n    if not os.path.exists(config_path):\n        cfg = {app_name: config_template.copy(), \"version\": \"v0\", \"explicit\": True}\n        # Specific prefix for Silent Hill f\n        if title == \"Silent Hill f\":\n            cfg[app_name][\"winePrefix\"] = os.path.join(HEROIC_PREFIXES, \"silent hill f\")\n        with open(config_path, \"w\") as f:\n            json.dump(cfg, f, indent=2)\n        gamesconfig_count += 1\n\nprint(f\"New GamesConfig files: {gamesconfig_count}\")\n\n# === LUTRIS CONFIG ===\nLUTRIS_GAMES_DIR = os.path.expanduser(\"~/.local/share/lutris/games\")\nLUTRIS_DB = os.path.expanduser(\"~/.local/share/lutris/pga.db\")\nLUTRIS_RUNNER = \"Proton-GE Latest\"  # Lutris runner name\nLUTRIS_PREFIX = os.path.expanduser(\"~/Games/Heroic/Prefixes/shared\")\n\nos.makedirs(LUTRIS_GAMES_DIR, exist_ok=True)\n\n# Read existing Lutris DB games\nconn = sqlite3.connect(LUTRIS_DB)\ncur = conn.cursor()\nexisting_lutris = set()\ntry:\n    for row in cur.execute(\"SELECT name FROM games\"):\n        existing_lutris.add(row[0].lower())\nexcept:\n    # table might not exist yet\n    cur.execute(\"CREATE TABLE IF NOT EXISTS games (id INTEGER PRIMARY KEY, name TEXT, runner TEXT, directory TEXT, installed INTEGER)\")\n    cur.execute(\"CREATE TABLE IF NOT EXISTS categories (id INTEGER PRIMARY KEY, name TEXT)\")\n    cur.execute(\"CREATE TABLE IF NOT EXISTS games_categories (game_id INTEGER, category_id INTEGER)\")\n    cur.execute(\"CREATE TABLE IF NOT EXISTS service_games (id INTEGER PRIMARY KEY, game_id INTEGER, service_id TEXT, app_id TEXT)\")\n    cur.execute(\"CREATE TABLE IF NOT EXISTS sources (id INTEGER PRIMARY KEY, name TEXT)\")\n    cur.execute(\"CREATE TABLE IF NOT EXISTS saved_searches (id INTEGER PRIMARY KEY, name TEXT, search TEXT, icon TEXT)\")\n    conn.commit()\n\nprint(f\"\\nExisting Lutris games in DB: {len(existing_lutris)}\")\n\n# Generate Lutris YAML and DB entries\nlutris_new = 0\nyaml_new = 0\n\nfor title, exe in all_games:\n    slug = slugify(title)\n    folder = os.path.dirname(exe)\n    \n    # Generate a deterministic hash for the YAML filename\n    yaml_hash = hashlib.md5(exe.encode())[:8]\n    yaml_name = f\"{slug}-{yaml_hash}.yml\"\n    yaml_path = os.path.join(LUTRIS_GAMES_DIR, yaml_name)\n    \n    title_lower = title.lower()\n    \n    # Create YAML if not exists\n    if not os.path.exists(yaml_path):\n        yaml_content = f\"\"\"game:\n  exe: {exe}\n  prefix: {LUTRIS_PREFIX}\n  working_dir: {folder}/\nsystem:\n  mangohud: true\nwine:\n  version: {LUTRIS_RUNNER}\n\"\"\"\n        with open(yaml_path, \"w\") as f:\n            f.write(yaml_content)\n        yaml_new += 1\n    \n    # Insert into DB if not exists\n    if title_lower not in existing_lutris:\n        cur.execute(\n            \"INSERT INTO games (name, runner, directory, installed) VALUES (?, ?, ?, ?)\",\n            (title, \"wine\", folder, 1)\n        )\n        existing_lutris.add(title_lower)\n        lutris_new += 1\n\nconn.commit()\nconn.close()\n\nprint(f\"New Lutris YAML files: {yaml_new}\")\nprint(f\"New Lutris DB entries: {lutris_new}\")\nprint(\"\\nDone! Summary:\")\nprint(f\"  Heroic sideload library: {len(existing['games'])} total games\")\nprint(f\"  Heroic GamesConfig files: {len(os.listdir(HEROIC_GAMESCONFIG))} files\")\nprint(f\"  Lutris YAML files: {len(os.listdir(LUTRIS_GAMES_DIR))} files\")\n\nPYEOF" action.permission=* action.action=allow action.pattern=*
