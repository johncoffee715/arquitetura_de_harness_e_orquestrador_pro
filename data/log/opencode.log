timestamp=2026-07-13T20:14:47.774Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 << 'EOF'\nimport hashlib\n\nfiles = {\n    'Original Pro VII': '/home/johncoffee/backup_ProVII_Lenovo_completo.rom',\n    'OD-enabled (flashed)': '/home/johncoffee/backup_ProVII_OD_flashed.rom',\n    'OD source': '/tmp/ProVII_OD_enabled.rom',\n}\n\nfor name, path in files.items():\n    with open(path, 'rb') as f:\n        data = f.read()\n    print(f\"  {name}: {len(data)} bytes, MD5 {hashlib.md5(data).hexdigest()}\")\n\n# Check the OD source vs flashed backup\nwith open('/tmp/ProVII_OD_enabled.rom', 'rb') as f:\n    src = f.read()\nwith open('/home/johncoffee/backup_ProVII_OD_flashed.rom', 'rb') as f:\n    dst = f.read()\n\nprint(f\"\\n=== Flashed ROM analysis ===\")\nprint(f\"Sizes match: {len(src)} == {len(dst)}? {len(src) == len(dst)}\")\n\n# The backup is 1MB (0x100000), our source is 512KB (0x80000)\n# The backup should have first 512KB = source, remaining 512KB = 0xFF\nprint(f\"First 512KB matches source: {src == dst[:0x80000]}\")\nprint(f\"Second 512KB is all 0xFF: {all(b == 0xff for b in dst[0x80000:])}\")\nprint(f\"Total size: {len(dst)} bytes ({len(dst)//1024}KB)\")\n\n# Also verify OD flags are present in the flashed ROM\noffset_od = 0x1a2c4  # OD flag location\nprint(f\"\\n=== OD flag check ===\")\nprint(f\"Original OD byte at 0x{offset_od:x}: was 0x00 (off), now 0x{dst[offset_od]:02x}\")\nprint(f\"OD is ON: {dst[offset_od] == 0x80}\")\nEOF" action.permission=* action.action=allow action.pattern=*
