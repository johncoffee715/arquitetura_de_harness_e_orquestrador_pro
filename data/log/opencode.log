timestamp=2026-07-12T23:41:29.680Z level=INFO run=56d81d33 message=evaluated permission=bash pattern="python3 -c \"\nimport zlib, os, glob, re\n\nyaml_dir = os.path.expanduser('~/.local/share/lutris/games/')\ncorrect = 0\nwrong = 0\nfor f in glob.glob(f'{yaml_dir}/*.yml'):\n    # Extract the hash part (last number before .yml)\n    match = re.search(r'-(\\d+)\\.yml$', f)\n    # Also check if the yaml file actually has a valid exe\n    if match:\n        expected_hash = int(match.group(1))\n        # Read the yaml to get the exe\n        with open(f) as yf:\n            content = yf.read()\n        import re as re2\n        exe_match = re2.search(r'exe: (.+)', content)\n        if exe_match:\n            exe_path = exe_match.group(1).strip()\n            actual_hash = zlib.adler32(exe_path.encode())\n            if actual_hash == expected_hash:\n                correct += 1\n            else:\n                wrong += 1\n                name = os.path.basename(f)\n                print(f'WRONG HASH: {name}')\n                print(f'  exe: {exe_path}')\n                print(f'  expected hash: {expected_hash}')\n                print(f'  actual adler32: {actual_hash}')\n    else:\n        wrong += 1\n        print(f'CANT PARSE: {os.path.basename(f)}')\nprint(f'Correct YAML hashes: {correct}')\nprint(f'Wrong YAML hashes: {wrong}')\n\"" action.permission=* action.action=allow action.pattern=*
