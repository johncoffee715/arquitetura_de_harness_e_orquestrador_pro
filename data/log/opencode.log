timestamp=2026-07-13T20:15:14.888Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 << 'EOF'\n# Compare the ORIGINAL 512KB ROM with our OD-enabled source\noriginal_512k = '/mnt/win1/123 tranqueiras e projetos/projeto bios mod/bios mi50/277846.rom'\nod_source = '/tmp/ProVII_OD_enabled.rom'\n\nwith open(original_512k, 'rb') as f:\n    orig = f.read()\nwith open(od_source, 'rb') as f:\n    mod = f.read()\n\nprint(f\"Original size: {len(orig)}, Modified size: {len(mod)}\")\nprint(f\"Same size: {len(orig) == len(mod)}\")\n\n# Find all differences\ndiffs = []\nfor i in range(min(len(orig), len(mod))):\n    if orig[i] != mod[i]:\n        diffs.append((i, orig[i], mod[i]))\n\nprint(f\"\\nTotal differences: {len(diffs)}\")\nfor offset, ob, mb in diffs:\n    print(f\"  Offset 0x{offset:x} (0x{offset:06x}): 0x{ob:02x} → 0x{mb:02x}\")\nEOF" action.permission=* action.action=allow action.pattern=*
