timestamp=2026-07-10T22:39:52.368Z level=INFO run=64d83dc1 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nresults = [\n    (\"Stock\", 1700, 0, 13000, \"100%\"),\n    (\"Step 1\", 1750, 50, 13339, \"+2.6%\"),\n    (\"Step 2\", 1800, 100, 13689, \"+5.3%\"),\n    (\"Step 3\", 1850, 150, 13886, \"+6.8%\"),\n    (\"Step 4\", 1900, 200, 14247, \"+9.6%\"),\n    (\"Step 5\", 1950, 250, 14862, \"+14.3%\"),\n    (\"Step 6\", 2000, 300, 14993, \"✅ +15.3%\"),\n]\n\n# Theoretical max at each step\nprint(f\"{'Step':<10} {'SCLK':<8} {'+MHz':<8} {'FP32 GFLOPS':<14} {'Theoretical':<14} {'Efficiency':<12} {'Gain':<10}\")\nprint(\"-\"*76)\nfor name, sclk, add, fp32, gain in results:\n    theoretical = sclk * 3840 * 2 / 1000  # in TFLOPS\n    eff = fp32 / (theoretical * 1000) * 100\n    print(f\"{name:<10} {sclk:<8} +{add:<6} {fp32:<14.2f} {theoretical:<14.2f} {eff:<11.1f}% {gain:<10}\")\n\nprint(f\"\\n✅ Final: Radeon Pro VII overclocked 1700MHz -> 2000MHz via pp_table patching\")\nprint(f\"   FP32: 13.0 -> 15.0 TFLOPS (+15.3%)\")\nprint(f\"   FP64: 6.5 -> 7.45 TFLOPS (+14.6%)\")\nPYEOF" action.permission=bash action.pattern="python3 *" action.action=allow
