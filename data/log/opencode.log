timestamp=2026-07-13T12:03:53.645Z level=INFO run=04d92069 message=evaluated permission=bash pattern="cat > /home/johncoffee/apply-gpu-patch-2140mhz.sh << 'SCRIPT'\n#!/bin/bash\n# apply-gpu-patch.sh — Aplica pp_table 2140 MHz c/ +50mV VDDC na Radeon Pro VII\n# Versão persistente para apply-gpu-patch.service\n\nPP_TABLE=\"/sys/class/drm/card1/device/pp_table\"\nOC_FILE=\"/mnt/dados/gpu-fw/mi50/pp_table_patches/pp_table_2140mhz.bin\"\nOD=\"/sys/class/drm/card1/device/pp_od_clk_voltage\"\n\n# 1. Carregar pp_table com 2140 MHz\nif [ -w \"$PP_TABLE\" ] && [ -f \"$OC_FILE\" ]; then\n    cat \"$OC_FILE\" > \"$PP_TABLE\"\n    logger \"[gpu-patch] pp_table 2140 MHz carregada\"\nfi\n\n# 2. Aplicar override da freq + +50mV VDDC\nif [ -w \"$OD\" ]; then\n    echo \"s 8 2140\" > \"$OD\" 2>/dev/null\n    echo \"v 50\" > \"$OD\" 2>/dev/null\n    echo \"c\" > \"$OD\" 2>/dev/null\n    logger \"[gpu-patch] Override SCLK 2140 MHz +50mV VDDC aplicado\"\nfi\n\nlogger \"[gpu-patch] GPU configurada: 2140 MHz / +50mV / level 8\"\nSCRIPT" action.permission=* action.action=allow action.pattern=*
