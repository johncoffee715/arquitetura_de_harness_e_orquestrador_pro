timestamp=2026-07-13T18:51:08.378Z level=INFO run=047e387f message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport struct\n\ndata = open('/mnt/dados/gpu-fw/mi50/pp_table_patches/pp_table_2140mhz.bin', 'rb').read()\n\n# Vega20 pp_table: SCLK voltage table geralmente começa em ~0x340\n# Estrutura típica: pares de (freq 2bytes, voltage 2bytes)\n# Vamos procurar valores de voltage (mV) perto das frequencias\n\nprint(\"=== SCLK DPM States (freq + voltage) ===\")\n# Offsets aproximados para tabela de SCLK (16 bytes por state? ou 8?)\n# Procurando pelo padrão das frequencias\nfreqs = [859, 860, 1153, 1316, 1425, 1514, 1583, 1654, 2140]\nfor i, f in enumerate(freqs):\n    f_bytes = struct.pack('<H', f)\n    pos = data.find(f_bytes)\n    if pos >= 0:\n        vol = struct.unpack('<H', data[pos+2:pos+4])[0] if pos+4 <= len(data) else 0\n        print(f\"  Level {i}: {f} MHz @ {vol} mV (offset 0x{pos:04x})\")\n    else:\n        print(f\"  Level {i}: {f} MHz -> NOT FOUND in raw search\")\n\n# Procurar voltagem 1162 (0x048a)\nprint(f\"\\n1162 mV encontrado em offsets: \", end=\"\")\nfor i in range(0, len(data)-1):\n    if struct.unpack('<H', data[i:i+2])[0] == 1162:\n        print(f\"0x{i:04x} \", end=\"\")\nprint()\nPYEOF" action.permission=bash action.pattern=* action.action=ask
timestamp=2026-07-13T18:51:08.379Z level=INFO run=047e387f message=asking id=per_f5cd19adb001MMPOwiFY4dRUMV permission=bash patterns="[\"python3 << 'PYEOF'\\nimport struct\\n\\ndata = open('/mnt/dados/gpu-fw/mi50/pp_table_patches/pp_table_2140mhz.bin', 'rb').read()\\n\\n# Vega20 pp_table: SCLK voltage table geralmente começa em ~0x340\\n# Estrutura típica: pares de (freq 2bytes, voltage 2bytes)\\n# Vamos procurar valores de voltage (mV) perto das frequencias\\n\\nprint(\\\"=== SCLK DPM States (freq + voltage) ===\\\")\\n# Offsets aproximados para tabela de SCLK (16 bytes por state? ou 8?)\\n# Procurando pelo padrão das frequencias\\nfreqs = [859, 860, 1153, 1316, 1425, 1514, 1583, 1654, 2140]\\nfor i, f in enumerate(freqs):\\n    f_bytes = struct.pack('<H', f)\\n    pos = data.find(f_bytes)\\n    if pos >= 0:\\n        vol = struct.unpack('<H', data[pos+2:pos+4])[0] if pos+4 <= len(data) else 0\\n        print(f\\\"  Level {i}: {f} MHz @ {vol} mV (offset 0x{pos:04x})\\\")\\n    else:\\n        print(f\\\"  Level {i}: {f} MHz -> NOT FOUND in raw search\\\")\\n\\n# Procurar voltagem 1162 (0x048a)\\nprint(f\\\"\\\\n1162 mV encontrado em offsets: \\\", end=\\\"\\\")\\nfor i in range(0, len(data)-1):\\n    if struct.unpack('<H', data[i:i+2])[0] == 1162:\\n        print(f\\\"0x{i:04x} \\\", end=\\\"\\\")\\nprint()\\nPYEOF\"]"
