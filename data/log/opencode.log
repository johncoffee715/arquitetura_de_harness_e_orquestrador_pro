timestamp=2026-07-10T22:36:01.669Z level=INFO run=64d83dc1 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport struct\n\nwith open('/sys/class/drm/card1/device/pp_table', 'rb') as f:\n    data = bytearray(f.read())\n\n# Step 2: SCLK 1800MHz, MCLK 1080MHz\npatches = [\n    (842, 0x06A4, 0x0708, \"SCLK max DPM table\"),\n    (1010, 0x06A4, 0x0708, \"SCLK max copy 1\"),\n    (1066, 0x06A4, 0x0708, \"SCLK max copy 2\"),\n    (926, 0x03E8, 0x0438, \"MCLK max DPM table\"),\n    (928, 0x03E8, 0x0438, \"MCLK max copy\"),\n]\n\nfor off, orig_val, new_val, desc in patches:\n    current = struct.unpack('<H', data[off:off+2])[0]\n    if current != orig_val:\n        print(f\"⚠️  {desc} at offset {off}: expected 0x{orig_val:04x}, got 0x{current:04x}\")\n        continue\n    struct.pack_into('<H', data, off, new_val)\n    print(f\"✅ {desc}: 0x{orig_val:04x} -> 0x{new_val:04x}\")\n\nwith open('/tmp/pp_table_step2.bin', 'wb') as f:\n    f.write(data)\nprint(\"\\n✅ Step 2 patch saved to /tmp/pp_table_step2.bin\")\nPYEOF" action.permission=bash action.pattern="python3 *" action.action=allow
