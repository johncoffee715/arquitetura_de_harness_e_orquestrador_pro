timestamp=2026-07-13T20:15:04.361Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 << 'EOF'\n# Verify OD flag in source vs flashed\nwith open('/tmp/ProVII_OD_enabled.rom', 'rb') as f:\n    src = f.read()\nwith open('/home/johncoffee/backup_ProVII_OD_flashed.rom', 'rb') as f:\n    dst = f.read()\n\noffset = 0x1a2c4\nprint(f\"OD flag at 0x{offset:x}:\")\nprint(f\"  Source (OD_enabled):  0x{src[offset]:02x}\")\nprint(f\"  Flashed backup:       0x{dst[offset]:02x}\")\nprint(f\"  Original backup:      0x{bs[offset]:02x}\" if 'bs' in dir() else \"\")\n\n# Check first few bytes at that offset range\nprint(f\"\\nBytes around offset 0x{offset:x}:\")\nprint(f\"  Source:     {src[offset-4:offset+8].hex()}\")\nprint(f\"  Flashed:    {dst[offset-4:offset+8].hex()}\")\n\n# Also verify with original backup\nwith open('/home/johncoffee/backup_ProVII_Lenovo_completo.rom', 'rb') as f:\n    orig = f.read()\nprint(f\"  Original:   {orig[offset-4:offset+8].hex()}\")\nEOF" action.permission=* action.action=allow action.pattern=*
