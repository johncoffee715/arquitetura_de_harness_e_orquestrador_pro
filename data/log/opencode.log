timestamp=2026-07-10T22:43:45.790Z level=INFO run=64d83dc1 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport struct\n\nwith open('/sys/class/drm/card1/device/pp_table', 'rb') as f:\n    data = bytearray(f.read())\n\n# Reverter de 2120 para 2100 MHz\npatches = [\n    (842, 0x0848, 0x0834, \"SCLK 2100\"),\n    (1010, 0x0848, 0x0834, \"SCLK copy 1\"),\n    (1066, 0x0848, 0x0834, \"SCLK copy 2\"),\n    (926, 0x053C, 0x0528, \"MCLK 1320\"),\n    (928, 0x053C, 0x0528, \"MCLK copy\"),\n]\nfor off, ov, nv, desc in patches:\n    curr = struct.unpack('<H', data[off:off+2])[0]\n    if curr != ov:\n        print(f\"⚠️  {desc}: expected {ov}, got {curr}\"); continue\n    struct.pack_into('<H', data, off, nv)\n    print(f\"✅ {desc}: {ov} -> {nv} MHz\")\n\n# Salvar versões\nwith open('/tmp/pp_table_2100_final.bin', 'wb') as f:\n    f.write(data)\n\n# Também criar versão max (2120 MHz)\nwith open('/sys/class/drm/card1/device/pp_table', 'rb') as f:\n    data2120 = bytearray(f.read())\n\nwith open('/tmp/pp_table_2120_max.bin', 'wb') as f:\n    f.write(data2120)\n\nprint(\"\\n✅ Versões salvas:\")\nprint(\"   Conservadora (2100 MHz): /tmp/pp_table_2100_final.bin\")\nprint(\"   Max estável (2120 MHz):   /tmp/pp_table_2120_max.bin\")\n\n# Aplicar versão final (2120 MHz max)\nimport os\nos.system('pkexec bash -c \"cat /tmp/pp_table_2120_max.bin > /sys/class/drm/card1/device/pp_table\"')\nPYEOF" action.permission=bash action.pattern="python3 *" action.action=allow
