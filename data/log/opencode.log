timestamp=2026-07-12T23:43:05.168Z level=INFO run=56d81d33 message=evaluated permission=bash pattern="python3 -c \"\n# Lutris game_file_id is computed from the game name\n# Let me check what algorithm produces 1783888157 from 'silent hill f'\nimport zlib, hashlib\n\nname = 'silent hill f'\nexe = '/mnt/win1/games/Silent Hill f/SHf.exe'\n\noptions = {\n    'adler32(name)': zlib.adler32(name.encode()),\n    'adler32(name.lower())': zlib.adler32(name.lower().encode()),\n    'adler32(exe)': zlib.adler32(exe.encode()),\n    'adler32(exe.lower())': zlib.adler32(exe.lower().encode()),\n    'crc32(name)': zlib.crc32(name.encode()) & 0xFFFFFFFF,\n    'crc32(exe)': zlib.crc32(exe.encode()) & 0xFFFFFFFF,\n    'hash(name)': hash(name) % 2**32,\n}\n\ntarget = '1783888157'\nfor k, v in options.items():\n    match = '<<<' if str(v) == target else ''\n    print(f'  {k}: {v} {match}')\n\"" action.permission=* action.action=allow action.pattern=*
