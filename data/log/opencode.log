timestamp=2026-07-13T19:11:35.218Z level=INFO run=fe8d3ba5 message=evaluated permission=bash pattern="sudo -S bash -c '\necho \"=== 0x30 PMBus (byte mode) ===\"\nfor reg in 00 19 21 29 2C 3A 3B 3C 46 8B 8C 8D 8E 8F 9A 9B; do\n    val=$(i2cget -y 0 0x30 0x$reg b 2>/dev/null)\n    echo \"  reg[0x$reg] = $val\"\ndone\necho \"\"\necho \"=== 0x32 PMBus (byte mode) ===\"\nfor reg in 00 19 21 29 2C 3A 3B 3C 46 8B 8C 8D 8E 8F 9A 9B; do\n    val=$(i2cget -y 0 0x32 0x$reg b 2>/dev/null)\n    echo \"  reg[0x$reg] = $val\"\ndone\n'" action.permission=bash action.pattern="sudo *" action.action=allow
