timestamp=2026-07-10T22:39:10.996Z level=INFO run=64d83dc1 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport struct, os\n\nwith open('/sys/class/drm/card1/device/pp_table', 'rb') as f:\n    data = bytearray(f.read())\n\npatches = [\n    (842, 0x079E, 0x07D0, \"SCLK max\"),    # 1950 -> 2000\n    (1010, 0x079E, 0x07D0, \"SCLK copy 1\"),\n    (1066, 0x079E, 0x07D0, \"SCLK copy 2\"),\n    (926, 0x04B0, 0x04D8, \"MCLK max\"),    # 1200 -> 1240\n    (928, 0x04B0, 0x04D8, \"MCLK copy\"),\n]\n\nfor off, ov, nv, desc in patches:\n    curr = struct.unpack('<H', data[off:off+2])[0]\n    if curr != ov:\n        print(f\"⚠️  {desc}: expected {ov}, got {curr}\")\n        continue\n    struct.pack_into('<H', data, off, nv)\n    print(f\"✅ {desc}: {ov} -> {nv} MHz\")\n\nwith open('/tmp/pp_table_step6.bin', 'wb') as f:\n    f.write(data)\n\nos.system('pkexec bash -c \"cat /tmp/pp_table_step6.bin > /sys/class/drm/card1/device/pp_table\"')\nPYEOF" action.permission=bash action.pattern="python3 *" action.action=allow
