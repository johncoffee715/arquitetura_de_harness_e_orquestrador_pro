timestamp=2026-07-13T18:06:29.009Z level=INFO run=007f36c8 message=evaluated permission=bash pattern="python3 -c \"\nimport json, os, re, yaml, glob, sqlite3\n\nheroic_config_dir = os.path.expanduser('~/.config/heroic/GamesConfig')\nheroic_lib_path = os.path.expanduser('~/.config/heroic/sideload_apps/library.json')\nyaml_dir = os.path.expanduser('~/.local/share/lutris/games')\ndb_path = os.path.expanduser('~/.local/share/lutris/pga.db')\n\n# Load Heroic library: app_name -> title\nwith open(heroic_lib_path) as f:\n    lib = json.load(f)\nheroic_title_map = {g['app_name']: g['title'] for g in lib['games']}\n\n# Load Lutris DB: configpath -> name\nconn = sqlite3.connect(db_path)\ncur = conn.cursor()\ncur.execute('SELECT configpath, name FROM games')\nlutris_name_map = {row[0]: row[1] for row in cur.fetchall()}\nconn.close()\n\ndef slugify(title):\n    s = title.lower().strip()\n    s = re.sub(r'[^a-z0-9]+', '-', s)\n    return s.strip('-')\n\n# Build Heroic prefix map: title_slug -> prefix\nheroic_prefixes = {}\nfor fname in os.listdir(heroic_config_dir):\n    if not fname.endswith('.json'):\n        continue\n    app_name = fname[:-5]\n    with open(os.path.join(heroic_config_dir, fname)) as f:\n        data = json.load(f)\n    cfg = data.get(app_name, {})\n    prefix = cfg.get('winePrefix', 'N/A')\n    title = heroic_title_map.get(app_name, app_name)\n    slug = slugify(title)\n    heroic_prefixes[slug] = prefix\n\n# Build Lutris prefix map: title_slug -> prefix\nlutris_prefixes = {}\nfor f in sorted(glob.glob(os.path.join(yaml_dir, '*.yml'))):\n    configpath = os.path.basename(f)[:-4]\n    name = lutris_name_map.get(configpath, '')\n    slug = slugify(name)\n    with open(f) as fh:\n        data = yaml.safe_load(fh)\n    prefix = data.get('game', {}).get('prefix', 'N/A')\n    lutris_prefixes[slug] = prefix\n\n# Compare\nprint('===== PREFIX MISMATCHES (Heroic vs Lutris) =====')\nmismatches = 0\nall_slugs = sorted(set(heroic_prefixes.keys()) | set(lutris_prefixes.keys()))\nfor slug in all_slugs:\n    h = heroic_prefixes.get(slug, 'N/A')\n    l = lutris_prefixes.get(slug, 'N/A')\n    if h != l:\n        print(f'{slug:40s} Heroic={h}')\n        print(f'{\\\"\\\":40s} Lutris={l}')\n        mismatches += 1\n\nif mismatches == 0:\n    print('All prefixes match!')\nelse:\n    print(f'\\n{mismatches} mismatches found')\n\"" action.permission=* action.action=allow action.pattern=*
