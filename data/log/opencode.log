timestamp=2026-07-13T12:02:15.942Z level=INFO run=04d92069 message=evaluated permission=bash pattern="python3 -c \"\nimport struct, shutil\n\nsrc = '/mnt/dados/gpu-fw/mi50/pp_table_patches/pp_table_overclocked_final.bin'\ndst = '/mnt/dados/gpu-fw/mi50/pp_table_patches/pp_table_2150mhz.bin'\n\nshutil.copy2(src, dst)\ndata = bytearray(open(dst, 'rb').read())\n\n# Patches: SCLK max de 2120 MHz (0x0848) para 2150 MHz (0x0866)\npatches = [\n    (0x034a, 2150),  # SCLK max table 1\n    (0x03f2, 2150),  # SCLK max table 2\n    (0x042a, 2150),  # SCLK max table 3\n]\n\nfor offset, freq in patches:\n    old = struct.unpack('<H', data[offset:offset+2])[0]\n    data[offset:offset+2] = struct.pack('<H', freq)\n    new = struct.unpack('<H', data[offset:offset+2])[0]\n    print(f'  0x{offset:04x}: {old} MHz → {new} MHz')\n\nopen(dst, 'wb').write(data)\nprint(f'\\nSalvo em: {dst}')\nprint(f'Tamanho: {len(data)} bytes')\n\"" action.permission=* action.action=allow action.pattern=*
