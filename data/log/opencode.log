timestamp=2026-07-10T22:34:47.202Z level=INFO run=64d83dc1 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport struct\n\nwith open('/sys/class/drm/card1/device/pp_table', 'rb') as f:\n    data = bytearray(f.read())\n\n# STEP 1: +50MHz SCLK (1700 -> 1750) +40MHz MCLK (1000 -> 1040)\npatches = []\n\n# SCLK max in DPM table (offset 842)\npatches.append((842, 0x06A4, 0x06D6, \"SCLK max DPM table\"))\n\n# SCLK max copies (secondary tables)\npatches.append((1010, 0x06A4, 0x06D6, \"SCLK max copy 1\"))\npatches.append((1066, 0x06A4, 0x06D6, \"SCLK max copy 2\"))\n\n# MCLK max in DPM table (offset 926)\npatches.append((926, 0x03E8, 0x0410, \"MCLK max DPM table\"))\n\n# MCLK max copy (offset 928)\npatches.append((928, 0x03E8, 0x0410, \"MCLK max copy\"))\n\n# Apply patches\nfor off, orig_val, new_val, desc in patches:\n    current = struct.unpack('<H', data[off:off+2])[0]\n    if current != orig_val:\n        print(f\"⚠️  {desc} at offset {off}: expected 0x{orig_val:04x}, got 0x{current:04x} - SKIPPING\")\n        continue\n    struct.pack_into('<H', data, off, new_val)\n    print(f\"✅ {desc} at offset {off}: 0x{orig_val:04x} ({orig_val}) -> 0x{new_val:04x} ({new_val})\")\n\n# Save\nwith open('/tmp/pp_table_overclocked.bin', 'wb') as f:\n    f.write(data)\n\nprint(f\"\\n✅ Saved to /tmp/pp_table_overclocked.bin ({len(data)} bytes)\")\n\n# Verify no accidental changes\nprint(\"\\n=== Verification ===\")\nwith open('/sys/class/drm/card1/device/pp_table', 'rb') as f:\n    original = f.read()\n\nfor off, orig_val, new_val, desc in patches:\n    current = struct.unpack('<H', data[off:off+2])[0]\n    was = struct.unpack('<H', original[off:off+2])[0]\n    status = \"✅\" if current == new_val and was == orig_val else \"❌\"\n    print(f\"{status} {desc}: was={was}, now={current}\")\n\n# Show SCLK table after patch\nprint(\"\\nSCLK DPM table after patch:\")\nfor i in range(9):\n    off = 826 + i*2\n    val = struct.unpack('<H', data[off:off+2])[0]\n    print(f\"  Level {i}: {val} MHz\")\n\nMCLK_off = 922\nprint(\"\\nMCLK DPM table after patch:\")\nfor i in range(3):\n    off = MCLK_off + i*2\n    val = struct.unpack('<H', data[off:off+2])[0]\n    print(f\"  Level {i}: {val} MHz\")\nPYEOF" action.permission=bash action.pattern="python3 *" action.action=allow
