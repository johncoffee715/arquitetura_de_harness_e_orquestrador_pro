timestamp=2026-07-13T19:26:42.280Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="sudo -S bash -c '\n# VRM GFX (0x30) — OCP atual = 0x00dd (221A)\n# Escrever 330A = 0x014a como word\necho \"=== VRM GFX (0x30) OCP: 221A → 330A ===\"\ni2cset -y 0 0x30 0x3B 0x014a w 2>&1\nsleep 0.5\necho \"Verificando:\"\ni2cget -y 0 0x30 0x3B w 2>&1\n\necho \"\"\necho \"=== IR35217 SoC (0x32) OCP: 0x9292 → 0xB092 ===\"\ni2cset -y 0 0x32 0x3B 0xB092 w 2>&1\nsleep 0.5\necho \"Verificando:\"\ni2cget -y 0 0x32 0x3B w 2>&1\n\necho \"\"\necho \"=== Estado GPU apos ajuste ===\"\ncat /sys/class/drm/card1/device/pp_dpm_sclk | grep \"\\*\"\ncat \"/sys/kernel/debug/dri/0000:05:00.0/amdgpu_pm_info\" 2>/dev/null | grep -E \"SCLK|VDDGFX|Temp|SoC\"\n'" action.permission=* action.action=allow action.pattern=*
