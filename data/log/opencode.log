timestamp=2026-07-13T19:45:38.663Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport hashlib\n\ndata = bytearray(open('ProVII_Lenovo_OD_enabled.rom', 'rb').read())\norig = data.decode('latin-1')\n\n# Corrigir versao: 015933 -> 015934\nidx_ver = orig.find('016.004.000.064.')\nprint(f\"  Versao em 0x{idx_ver:05x}\")\ndata[idx_ver+len('016.004.000.064.'):idx_ver+len('016.004.000.064.015933')] = b'015934'\n\n# Data: 12/08/20 -> 01/09/20 (feita, verificar)\nidx_date = orig.find('12/08/20 18:42')\nif idx_date >= 0:\n    data[idx_date:idx_date+14] = b'01/09/20 18:42'\n    print(f\"  Data patched\")\n\n# Recalcular checksum legacy\ncs_offset = 0x21\nold_cs = data[cs_offset]\nchecksum = sum(data[0:cs_offset]) + sum(data[cs_offset+1:0x100])\ndata[cs_offset] = (256 - (checksum & 0xFF)) & 0xFF\nprint(f\"  Checksum legacy: 0x{old_cs:02x} -> 0x{data[cs_offset]:02x}\")\n\nmd5 = hashlib.md5(data).hexdigest()\nopen('ProVII_Lenovo_OD_enabled.rom', 'wb').write(data)\nprint(f\"  MD5: {md5}\")\nprint(f\"  Versao: 016.004.000.064.015934\")\nprint(f\"  Data: 01/09/20 18:42\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
