timestamp=2026-07-13T19:39:56.125Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport struct\n\ndata = bytearray(open('ProVII_Lenovo_OD_enabled.rom', 'rb').read())\n\n# ODSettingsMax — em 0x0D454 temos: a4 06 6e 04 cc 03\n# a4 06 = 1700 (SCLK max) -> 2140 = 0x085c\n# 6e 04 = 1134 (?) -> 1340 = 0x053c (MCLK max)  \n# cc 03 = 1000 (?) -> 1340 = 0x053c\n\nprint(\"=== ODSettingsMax antes ===\")\nfor off in [0x0D454, 0x0D3AC]:\n    vals = [struct.unpack('<H', data[off+i:off+i+2])[0] for i in range(0, 12, 2)]\n    hexs = ' '.join(f'{b:02x}' for b in data[off:off+12])\n    print(f\"  0x{off:05x}: {hexs} -> {vals}\")\n\n# Patch ODSettingsMax[0] = SCLK max: 1700 -> 2140\ndata[0x0D454:0x0D456] = struct.pack('<H', 2140)\n\n# Patch ODSettingsMax[2] = MCLK max: 1000 -> 1340\ndata[0x0D458:0x0D45A] = struct.pack('<H', 1340)\n\nprint()\nprint(\"=== ODSettingsMax depois ===\")\nfor off in [0x0D454]:\n    vals = [struct.unpack('<H', data[off+i:off+i+2])[0] for i in range(0, 12, 2)]\n    hexs = ' '.join(f'{b:02x}' for b in data[off:off+12])\n    print(f\"  0x{off:05x}: {hexs} -> {vals}\")\n\n# Tambem patch SCLK DPM states: 1700 -> 2140 no level 8\n# Em 0x0D3AC: 2f 06 76 06 a4 06 (1583, 1654, 1700)\n# O ultimo (1700) e o level 8\ndata[0x0D3B0:0x0D3B2] = struct.pack('<H', 2140)  # SCLK level 8\n\n# Outros offsets onde 1700 aparece na regiao OD\n# 0x0D089: a4 06 = 1700 — provavelmente FreqTableGfx max\ndata[0x0D089:0x0D08B] = struct.pack('<H', 2140)\n\n# 0x0D48C: a4 06 = 1700 — outro lugar\ndata[0x0D48C:0x0D48E] = struct.pack('<H', 2140)\n\nprint()\nprint(\"=== SCLK DPM level 8 depois ===\")\nfor off in [0x0D3AC, 0x0D089, 0x0D48C]:\n    vals = [struct.unpack('<H', data[off+i:off+i+2])[0] for i in range(0, 6, 2)]\n    print(f\"  0x{off:05x}: {vals}\")\n\n# Recalcular checksum do bloco legacy (0x00-0xFF)\nchecksum_offset = 0x21\nold_cs = data[checksum_offset]\nchecksum = sum(data[0:checksum_offset]) + sum(data[checksum_offset+1:0x100])\ndata[checksum_offset] = (256 - (checksum & 0xFF)) & 0xFF\nprint(f\"\\n  Checksum legacy: 0x{old_cs:02x} -> 0x{data[checksum_offset]:02x}\")\n\nimport hashlib\nmd5 = hashlib.md5(data).hexdigest()\nopen('ProVII_Lenovo_OD_enabled.rom', 'wb').write(data)\nprint(f\"\\n  Salvo: ProVII_Lenovo_OD_enabled.rom\")\nprint(f\"  MD5: {md5}\")\nprint(f\"  Tamanho: {len(data)} bytes\")\nprint()\nprint(\"  OD features ativados: GFXCLK_LIMITS [0], UCLK_MAX [2]\")\nprint(\"  SCLK max: 1700 -> 2140 MHz\")\nprint(\"  MCLK max: 1000 -> 1340 MHz\")\nprint(\"  Display: 6x mini-DP (original Pro VII) — sem alteracao\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
