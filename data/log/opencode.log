timestamp=2026-07-13T20:09:45.758Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 << 'EOF'\nwith open('/tmp/amdvbflash_patched', 'rb') as f:\n    data = bytearray(f.read())\n\n# VA 0x424486 → file offset 0x024486\n# Original instruction: 75 1d (jne +0x1d)\n# Change to: eb 1d (jmp +0x1d) - always jump to success path\noff1 = 0x024486\nprint(f'Patch 1 at file offset 0x{off1:x}:')\nprint(f'  Before: {data[off1]:02x} {data[off1+1]:02x}')\nassert data[off1] == 0x75, f\"Expected 0x75 at 0x{off1:x}, got 0x{data[off1]:02x}\"\ndata[off1] = 0xeb  # jne → jmp\nprint(f'  After:  {data[off1]:02x} {data[off1+1]:02x}')\n\n# VA 0x424714 → file offset 0x024714\n# Original instruction: 75 15 (jne +0x15) - jump to FAILED path\n# Change to: 90 90 (nop nop) - fall through to PASS path\noff2 = 0x024714\nprint(f'\\nPatch 2 at file offset 0x{off2:x}:')\nprint(f'  Before: {data[off2]:02x} {data[off2+1]:02x}')\nassert data[off2] == 0x75, f\"Expected 0x75 at 0x{off2:x}, got 0x{data[off2]:02x}\"\ndata[off2] = 0x90  # nop\ndata[off2+1] = 0x90  # nop\nprint(f'  After:  {data[off2]:02x} {data[off2+1]:02x}')\n\n# Save patched binary\nwith open('/tmp/amdvbflash_patched_norsa', 'wb') as f:\n    f.write(data)\n\n# Verify patch\nimport hashlib\nprint(f'\\nCreated /tmp/amdvbflash_patched_norsa')\nprint(f'MD5: {hashlib.md5(data).hexdigest()}')\nprint(f'Size: {len(data)} bytes')\nEOF" action.permission=* action.action=allow action.pattern=*
