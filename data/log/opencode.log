timestamp=2026-07-13T19:12:16.545Z level=INFO run=fe8d3ba5 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport struct, shutil\n\n# Criar pp_table 2100 MHz a partir do stock\nstock = '/mnt/dados/gpu-fw/mi50/backups/pp_table_20260710_172626.bin'\ndst = '/mnt/dados/gpu-fw/mi50/pp_table_patches/pp_table_2100mhz.bin'\n\nshutil.copy2(stock, dst)\ndata = bytearray(open(dst, 'rb').read())\n\n# SCLK max: 1700 → 2100 MHz nos 3 offsets\n# Offsets confirmados do diff anterior: 0x34a, 0x3f2, 0x42a (mas no stock sao 1700 = 0x06a4)\n# No stock os offsets podem ser diferentes — vamos procurar 1700 (0x06a4)\nval_1700 = struct.pack('<H', 1700)\nval_2100 = struct.pack('<H', 2100)\n\ncount = 0\nidx = 0\nwhile True:\n    idx = data.find(val_1700, idx)\n    if idx == -1:\n        break\n    data[idx:idx+2] = val_2100\n    print(f\"  0x{idx:04x}: 1700 → 2100 MHz\")\n    count += 1\n    idx += 2\n\n# MCLK: 1000 → 1340 MHz (offsets 0x39e-0x3a1 tinham 1000 no stock)\nval_1000 = struct.pack('<H', 1000)\nval_1340 = struct.pack('<H', 1340)\nidx = 0\nwhile True:\n    idx = data.find(val_1000, idx)\n    if idx == -1:\n        break\n    data[idx:idx+2] = val_1340\n    print(f\"  0x{idx:04x}: 1000 → 1340 MHz (MCLK)\")\n    idx += 2\n\n# TDP: 190 → 350W (offsets 0x16, 0x18, 0x1a, 0x1e6, 0x1f6, 0x4d1)\nval_190 = struct.pack('<H', 190)\nval_350 = struct.pack('<H', 350)\nidx = 0\nwhile True:\n    idx = data.find(val_190, idx)\n    if idx == -1:\n        break\n    data[idx:idx+2] = val_350\n    idx += 2\n\n# TDC: precisa encontrar offset 0x4a e setar 300\nif len(data) >= 0x4C:\n    data[0x4A:0x4C] = struct.pack('<H', 300)\n\nopen(dst, 'wb').write(data)\nprint(f\"\\nSalvo: {dst} ({len(data)} bytes)\")\nprint(f\"SCLK patches: {count}\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
