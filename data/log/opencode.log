timestamp=2026-07-13T19:23:40.026Z level=INFO run=005dc7fd message=evaluated permission=external_directory pattern="/mnt/win1/123 tranqueiras e projetos/projeto bios mod/bios mi50/*" action.permission=external_directory action.action=allow action.pattern=*
timestamp=2026-07-13T19:23:40.027Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 << 'PYEOF'\n# Comparar Pro VII Lenovo (277846.rom) com MI50 Server (AMD.MI50.16384.210512.rom)\n# Para encontrar diferencas nos parametros de VRM/SMBus\n\nproVII = open('277846.rom', 'rb').read()\nmi50 = open('AMD.MI50.16384.210512.rom', 'rb').read()\n\nprint(f\"Pro VII Lenovo: {len(proVII)} bytes\")\nprint(f\"MI50 Server:    {len(mi50)} bytes\")\nprint()\n\n# Sao tamanhos diferentes (512KB vs 1024KB)\n# Mas os primeiros 512KB devem ser compativeis\nmin_len = min(len(proVII), len(mi50))\n\ndiffs = []\nfor i in range(min_len):\n    if proVII[i] != mi50[i]:\n        diffs.append((i, proVII[i], mi50[i]))\n\nprint(f\"Diferencas nos primeiros {min_len} bytes: {len(diffs)}\")\nprint()\n\n# Agrupar diferencas em regioes contiguas\nif diffs:\n    regions = []\n    start = diffs[0][0]\n    last = start\n    for offset, pv, m5 in diffs[1:]:\n        if offset == last + 1:\n            last = offset\n        else:\n            regions.append((start, last))\n            start = offset\n            last = offset\n    regions.append((start, last))\n    \n    print(f\"Regioes diferentes: {len(regions)}\")\n    print()\n    for start, end in regions[:40]:\n        size = end - start + 1\n        pv_bytes = proVII[start:end+1]\n        m5_bytes = mi50[start:end+1]\n        pv_hex = ' '.join(f'{b:02x}' for b in pv_bytes[:16])\n        m5_hex = ' '.join(f'{b:02x}' for b in m5_bytes[:16])\n        print(f\"  0x{start:05x}-0x{end:05x} ({size:3d}B): ProVII=[{pv_hex}] MI50=[{m5_hex}]\")\n    \n    if len(regions) > 40:\n        print(f\"  ... e mais {len(regions)-40} regioes\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
