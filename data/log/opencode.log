timestamp=2026-07-13T20:13:01.041Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 << 'EOF'\nwith open('/tmp/amdvbflash_patched', 'rb') as f:\n    data = f.read()\n\n# Search for the bytes of a call to 0x4243a0\n# call rel32: E8 xx xx xx xx\n# 0x4243a0 - target\n# call_instruction_addr + 5 + rel32 = target\n# rel32 = target - call_instruction_addr - 5\n# For a call at address X: rel32 = 0x4243a0 - X - 5\n# We need E8 followed by bytes that decode to this offset\n\n# Actually let me just search for any E8 bytes near 0x4243a0\n# The call instruction relative to this function start\nimport struct\n\n# If there's a call to 0x4243a0, the instruction would be:\n# E8 <4-byte-signed-little-endian-offset>\n# offset = 0x4243a0 - addr_of_next_instruction\n# where addr_of_next_instruction = call_addr + 5\n\nfor offset in range(0, len(data) - 5):\n    if data[offset] == 0xe8:\n        next_addr = offset + 5 + 0x400000\n        rel32 = int.from_bytes(data[offset+1:offset+5], 'little', signed=True)\n        target = next_addr + rel32\n        if target == 0x4243a0:\n            va = offset + 0x400000\n            print(f\"Call at VA 0x{va:x} (file 0x{offset:x}) -> target 0x{target:x}\")\n        \nEOF" action.permission=* action.action=allow action.pattern=*
