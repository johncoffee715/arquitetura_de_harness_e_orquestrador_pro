timestamp=2026-07-13T19:26:30.081Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="sudo -S bash -c '\necho \"=== Antes de ajustar ===\"\necho \"VRM GFX (0x30) OCP:\"\ni2cget -y 0 0x30 0x3B w 2>&1\n\n# 330A em little-endian 16-bit = 0x014a = bytes 4a 01\necho \"\"\necho \"=== Escrevendo OCP=330A no VRM GFX ===\"\ni2cset -y 0 0x30 0x3B 0x4a 0x01 w 2>&1\necho \"Escrito. Verificando:\"\ni2cget -y 0 0x30 0x3B w 2>&1\n\necho \"\"\necho \"=== VRM SoC (0x32) OCP atual ===\"\necho \"IR35217 SoC OCP:\"\ni2cget -y 0 0x32 0x3B w 2>&1\n\n# O valor 0x9292 é formato LINEAR11\n# Para 50A no formato LINEAR11 com exponent=-3: valor = 50*8 = 400 = 0x0190\n# Mas o valor atual 0x9292 nao bate com formato LINEAR11 padrão\n# Vou tentar elevar mantendo o mesmo formato\n\n# Tentar escrever 0x9292 → 0xB092 (aumentar mantissa)\necho \"\"\necho \"=== Tentando elevar OCP SoC ===\"\ni2cset -y 0 0x32 0x3B 0x92 0xB0 w 2>&1\necho \"Verificando:\"\ni2cget -y 0 0x32 0x3B w 2>&1\n'" action.permission=* action.action=allow action.pattern=*
