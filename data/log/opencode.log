timestamp=2026-07-12T23:46:30.806Z level=INFO run=56d81d33 message=evaluated permission=bash pattern="python3 -c \"\nimport json\nwith open('/home/johncoffee/.config/heroic/sideload_apps/library.json') as f:\n    data = json.load(f)\nprint(f'Total games: {len(data[\\\"games\\\"])}')\n# Check for duplicate titles\nfrom collections import Counter\ntitles = [g['title'].lower() for g in data['games']]\ndupes = [t for t, c in Counter(titles).items() if c > 1]\nif dupes:\n    print(f'WARNING: Duplicate titles: {dupes}')\n    for g in data['games']:\n        if g['title'].lower() in dupes:\n            print(f'  {g[\\\"app_name\\\"]} - {g[\\\"title\\\"]}')\nelse:\n    print('No duplicate titles - OK')\n\n# Check NFS Rivals for launch arguments\nfor g in data['games']:\n    if 'rivals' in g['title'].lower():\n        args = g.get('install', {}).get('arguments', 'NONE')\n        print(f'NFS Rivals args: {args}')\n\"" action.permission=* action.action=allow action.pattern=*
