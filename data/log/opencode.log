timestamp=2026-07-13T18:00:56.576Z level=INFO run=92cd5172 message=evaluated permission=bash pattern="cat > /home/johncoffee/gpu-monitor.sh << 'SCRIPT'\n#!/bin/bash\n# gpu-monitor.sh — Monitora SCLK + temp durante o jogo\nLOG=\"/home/johncoffee/gpu-monitor.log\"\n\necho \"timestamp sclk_level sclk_mhz temp_c load_pct\" > \"$LOG\"\n\nwhile true; do\n    ts=$(date '+%H:%M:%S')\n    sclk=$(cat /sys/class/drm/card1/device/pp_dpm_sclk 2>/dev/null | grep '\\*' | grep -oP '\\d+Mhz' | tr -d 'Mhz')\n    level=$(cat /sys/class/drm/card1/device/pp_dpm_sclk 2>/dev/null | grep -n '\\*' | cut -d: -f1)\n    temp=$(cat /sys/class/drm/card1/device/hwmon/hwmon*/temp1_input 2>/dev/null | awk '{printf \"%d\", $1/1000}')\n    load=$(cat /sys/class/drm/card1/device/gpu_busy_percent 2>/dev/null)\n    echo \"$ts $level $sclk $temp $load\" >> \"$LOG\"\n    echo -ne \"\\r$ts | L$level ${sclk}MHz | ${temp}°C | ${load}%%   \"\n    sleep 2\ndone\nSCRIPT" action.permission=* action.action=allow action.pattern=*
