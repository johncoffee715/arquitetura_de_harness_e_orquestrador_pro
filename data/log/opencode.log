timestamp=2026-07-13T19:11:03.039Z level=INFO run=fe8d3ba5 message=evaluated permission=bash pattern="sudo -S bash -c '\necho \"=== 0x30 - Lendo PMBus ===\"\n# 0x00 = PAGE (0 ou 1 pra GFX ou SOC)\n# 0x21 = VOUT_COMMAND (tensao alvo)\n# 0x3B = IOUT_OC_FAULT_LIMIT (OCP!)\n# 0x8B = READ_VIN (tensao entrada)\n# 0x8C = READ_VOUT (tensao saida)  \n# 0x8D = READ_IOUT (corrente saida)\n# 0x8F = READ_TEMP\n\nfor reg in 00 21 3B 8B 8C 8D 8F; do\n    val=$(i2cget -y 0 0x30 0x$reg w 2>/dev/null)\n    echo \"  0x30 reg[0x$reg] = $val\"\ndone\n\necho \"\"\necho \"=== 0x32 - Lendo PMBus ===\"\nfor reg in 00 21 3B 8B 8C 8D 8F; do\n    val=$(i2cget -y 0 0x32 0x$reg w 2>/dev/null)\n    echo \"  0x32 reg[0x$reg] = $val\"\ndone\n'" action.permission=bash action.pattern="sudo *" action.action=allow
