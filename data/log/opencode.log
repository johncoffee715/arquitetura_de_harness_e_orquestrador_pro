timestamp=2026-07-13T19:12:51.685Z level=INFO run=fe8d3ba5 message=evaluated permission=bash pattern="sudo -S bash -c '\necho \"=== Lendo registros PMBus do IR35217 (0x32) ===\"\n# 0x3B = IOUT_OC_FAULT_LIMIT (OCP)\necho \"IOUT_OC_FAULT_LIMIT (0x3B):\"\ni2cget -y 0 0x32 0x3B w 2>&1\n\n# 0x4F = IOUT_OC_WARN_LIMIT  \necho \"IOUT_OC_WARN_LIMIT (0x4F):\"\ni2cget -y 0 0x32 0x4F w 2>&1\n\n# 0x21 = VOUT_COMMAND (tensao alvo)\necho \"VOUT_COMMAND (0x21):\"\ni2cget -y 0 0x32 0x21 w 2>&1\n\n# 0x2D = VOUT_OV_FAULT_LIMIT\necho \"VOUT_OV_FAULT_LIMIT (0x2D):\"\ni2cget -y 0 0x32 0x2D w 2>&1\n\n# 0x44 = IOUT_CAL_GAIN\necho \"IOUT_CAL_GAIN (0x44):\"\ni2cget -y 0 0x32 0x44 w 2>&1\n\n# 0x38 = IOUT_OC_FAULT_LIMIT page 1\necho \"Dando page 1 primeiro...\"\ni2cset -y 0 0x32 0x00 0x01 b 2>/dev/null\necho \"IOUT_OC_FAULT_LIMIT page1 (0x3B):\"\ni2cget -y 0 0x32 0x3B w 2>&1\n\n# Voltar pra page 0\ni2cset -y 0 0x32 0x00 0x00 b 2>/dev/null\n\necho \"\"\necho \"=== Agora o VRM GFX (0x30) ===\"\necho \"IOUT_OC_FAULT_LIMIT page0 (0x3B):\"\ni2cget -y 0 0x30 0x3B w 2>&1\n\ni2cset -y 0 0x30 0x00 0x01 b 2>/dev/null\necho \"IOUT_OC_FAULT_LIMIT page1 (0x3B):\"\ni2cget -y 0 0x30 0x3B w 2>&1\ni2cset -y 0 0x30 0x00 0x00 b 2>/dev/null\n'" action.permission=bash action.pattern="sudo *" action.action=allow
