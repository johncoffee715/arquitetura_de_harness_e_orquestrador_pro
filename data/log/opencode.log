timestamp=2026-07-13T19:39:09.172Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 << 'PYEOF'\nproVII = open('277846.rom', 'rb').read()\nmoon = open('MOONSHOT_D3600200-106_MI50.rom', 'rb').read()\n\n# OD features na Pro VII estao em 0x0D10E\n# Padrao: 0f 00 00 00 00 00 00 00 01 01 00 00 00 00 00 00 00 00 01\n# Do relatorio: ODFeatureCapabilities[0]=GFXCLK_LIMITS, [2]=UCLK_MAX\n\nprint(\"=== ProVII OD region (0x0D100-0x0D130) ===\")\nfor i in range(0x0D100, 0x0D130, 16):\n    hexs = ' '.join(f'{b:02x}' for b in proVII[i:i+16])\n    print(f\"  0x{i:05x}: {hexs}\")\n\nprint()\nprint(\"=== MOONSHOT OD region (0x0D100-0x0D130) ===\")\nfor i in range(0x0D100, 0x0D130, 16):\n    hexs = ' '.join(f'{b:02x}' for b in moon[i:i+16])\n    print(f\"  0x{i:05x}: {hexs}\")\n\n# Procurar o mesmo padrao OD no MOONSHOT\nprint()\nprint(\"=== Procurando padrao OD no MOONSHOT ===\")\n# O padrao do relatorio Pro VII em 0x0D10E:\n# 00 00 00 00 01 01 00 00 00 00 00 00 00 00 01\n# No MOONSHOT deve ter 01 00 01 00 01 01 (OD ON)\npattern = bytes([0x00, 0x00, 0x01, 0x01])\nfor i in range(0x0D000, 0x0E000):\n    if moon[i:i+4] == pattern:\n        # Verificar contexto\n        ctx = moon[i-8:i+16]\n        hexs = ' '.join(f'{b:02x}' for b in ctx)\n        print(f\"  Possivel em 0x{i:05x}: {hexs}\")\n\n# Comparar regiao 0x0D100-0x0D200 entre os dois\nprint()\nprint(\"=== Diff ProVII vs MOONSHOT em 0x0D100-0x0D200 ===\")\nfor i in range(0x0D100, min(0x0D200, len(proVII), len(moon))):\n    if proVII[i] != moon[i]:\n        print(f\"  0x{i:05x}: ProVII=0x{proVII[i]:02x} MOON=0x{moon[i]:02x}\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
