timestamp=2026-07-10T22:34:34.700Z level=INFO run=64d83dc1 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport struct\n\nwith open('/sys/class/drm/card1/device/pp_table', 'rb') as f:\n    data = bytearray(f.read())\n\nprint(\"=== Current state before patching ===\")\n\n# SCLK table (offset 826-843, 9 entries)\nprint(\"\\nSCLK DPM table:\")\nfor i in range(9):\n    off = 826 + i*2\n    val = struct.unpack('<H', data[off:off+2])[0]\n    print(f\"  Level {i}: {val} MHz (offset {off})\")\n\n# MCLK table - find it\nprint(\"\\nSearching for MCLK table (3 entries: 350, 800, 1000):\")\nfor off in range(0, len(data)-5, 2):\n    v1 = struct.unpack('<H', data[off:off+2])[0]\n    v2 = struct.unpack('<H', data[off+2:off+4])[0]\n    v3 = struct.unpack('<H', data[off+4:off+6])[0]\n    if v1 == 350 and v2 == 800 and v3 == 1000:\n        print(f\"  Found at offset {off}: {v1}, {v2}, {v3} MHz\")\n\n# Also check for partial MCLK with 1000 MHz\nprint(\"\\nAll occurrences of 1000 MHz:\")\nfor off in range(0, len(data)-1, 2):\n    val = struct.unpack('<H', data[off:off+2])[0]\n    if val == 1000:\n        # Show context\n        ctx = [struct.unpack('<H', data[off+i:off+i+2])[0] for i in range(-2, 10, 2)]\n        print(f\"  offset {off}: context={ctx}\")\n\nPYEOF" action.permission=bash action.pattern="python3 *" action.action=allow
