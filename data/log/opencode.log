timestamp=2026-07-13T19:46:03.732Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport struct, hashlib\n\nproVII = open('277846.rom', 'rb').read()\nbackup = open('/home/johncoffee/backup_ProVII_Lenovo_completo.rom', 'rb').read()\npatched = bytearray(open('ProVII_Lenovo_OD_enabled.rom', 'rb').read())\n\nprint(\"=== Timestamp EFI (offset 0x38 - 4 bytes little-endian) ===\")\n# EFI timestamp = seconds since epoch (unix time)\nfor name, d in [(\"ProVII src\", proVII), (\"Backup\", backup), (\"Patched\", patched)]:\n    ts_raw = d[0x38:0x3C]\n    ts = struct.unpack('<I', ts_raw)[0]\n    import datetime\n    dt = datetime.datetime.fromtimestamp(ts)\n    print(f\"  {name}: 0x{ts:08x} = {dt}\")\n\n# O timestamp EFI em 0x38 deve ser o que a tool compara\n# Bump para ser mais novo que o atual\nprint()\nprint(\"=== Patched ROM timestamp em 0x38 ===\")\nold_ts = struct.unpack('<I', patched[0x38:0x3C])[0]\nprint(f\"  Atual: 0x{old_ts:08x}\")\n\n# Bump para agora (13/07/2026)\nimport datetime\nnow = int(datetime.datetime(2026, 7, 13, 16, 0, 0).timestamp())\nprint(f\"  Novo:  0x{now:08x} ({datetime.datetime.fromtimestamp(now)})\")\n\npatched[0x38:0x3C] = struct.pack('<I', now)\n\n# Recalcular checksum\ncs_offset = 0x21\nchecksum = sum(patched[0:cs_offset]) + sum(patched[cs_offset+1:0x100])\npatched[cs_offset] = (256 - (checksum & 0xFF)) & 0xFF\n\nmd5 = hashlib.md5(patched).hexdigest()\nopen('ProVII_Lenovo_OD_enabled.rom', 'wb').write(patched)\nprint(f\"  Checksum: 0x{cs_offset:02x} = 0x{patched[cs_offset]:02x}\")\nprint(f\"  MD5: {md5}\")\nprint(f\"  Timestamp EFI patchado + checksum recalculado\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
