timestamp=2026-07-13T11:51:57.208Z level=INFO run=04d92069 message=evaluated permission=bash pattern="python3 -c \"\nimport struct\n\n# Comparar stock vs overclocked\nstock = open('/mnt/dados/gpu-fw/mi50/backups/pp_table_20260710_172626.bin', 'rb').read()\noc = open('/mnt/dados/gpu-fw/mi50/pp_table_patches/pp_table_overclocked_final.bin', 'rb').read()\n\nprint(f'Stock: {len(stock)} bytes')\nprint(f'OC:    {len(oc)} bytes')\nprint()\n\n# Mostrar diferenças byte a byte\ndiffs = []\nfor i in range(min(len(stock), len(oc))):\n    if stock[i] != oc[i]:\n        diffs.append((i, stock[i], oc[i]))\n\nprint(f'Total de bytes diferentes: {len(diffs)}')\nprint()\nfor offset, s, o in diffs[:30]:\n    print(f'  0x{offset:04x} ({offset:5d}): stock=0x{s:02x} ({s:3d})  OC=0x{o:02x} ({o:3d})')\nif len(diffs) > 30:\n    print(f'  ... e mais {len(diffs)-30} diferencas')\n\"" action.permission=* action.action=allow action.pattern=*
