timestamp=2026-07-12T23:46:33.001Z level=INFO run=56d81d33 message=evaluated permission=bash pattern="python3 -c \"\nimport sqlite3, os\nconn = sqlite3.connect(os.path.expanduser('~/.local/share/lutris/pga.db'))\ncur = conn.cursor()\ncur.execute('SELECT count(*) FROM games')\nprint(f'Total DB games: {cur.fetchone()[0]}')\n\n# Check for NFS Rivals\ncur.execute('SELECT id, name, executable, configpath FROM games WHERE name LIKE \\\"%Rivals%\\\"')\nrows = cur.fetchall()\nprint(f'NFS Rivals entries:')\nfor r in rows:\n    print(f'  ID={r[0]}, name={r[1]}, exe={r[2]}, configpath={r[3]}')\n\n# List YAML files\nyaml_dir = os.path.expanduser('~/.local/share/lutris/games')\nyaml_files = [f for f in os.listdir(yaml_dir) if f.endswith('.yml')]\nprint(f'\\\\nYAML files: {len(yaml_files)}')\n\n# Check Silent Hill f still preserved\ncur.execute('SELECT id, name, configpath FROM games WHERE name = \\\"silent hill f\\\"')\nprint(f'Silent Hill f: {cur.fetchone()}')\nconn.close()\n\"" action.permission=* action.action=allow action.pattern=*
