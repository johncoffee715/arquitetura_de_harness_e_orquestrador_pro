if struct.unpack('<H', verify[i:i+2])[0] == new_max_sclk)\nold_sclk_found = sum(1 for i in range(len(verify)-1) if struct.unpack('<H', verify[i:i+2])[0] == current_max_sclk)\nprint(f\"Verification: new_sclk={new_max_sclk} found {sclk_found}x, old_sclk={current_max_sclk} found {old_sclk_found}x\")\nPYEOF" action.permission=bash action.pattern="python3 *" action.action=allow
