timestamp=2026-07-13T18:06:07.840Z level=INFO run=007f36c8 message=evaluated permission=bash pattern="python3 -c \"\nimport os, re, yaml, sqlite3\n\nyaml_dir = os.path.expanduser('~/.local/share/lutris/games')\ndb_path = os.path.expanduser('~/.local/share/lutris/pga.db')\n\n# Load Lutris DB: configpath -> name\nconn = sqlite3.connect(db_path)\ncur = conn.cursor()\ncur.execute('SELECT configpath, name FROM games')\nconfigpath_to_name = {row[0]: row[1] for row in cur.fetchall()}\nconn.close()\n\ndef slugify(title):\n    s = title.lower().strip()\n    s = re.sub(r'[^a-z0-9]+', '-', s)\n    return s.strip('-')\n\nchanges = 0\nfor f in sorted(os.listdir(yaml_dir)):\n    if not f.endswith('.yml'):\n        continue\n    configpath = f[:-4]\n    title = configpath_to_name.get(configpath, '')\n    if not title:\n        print(f'WARNING: no DB match for {f}')\n        continue\n    \n    fpath = os.path.join(yaml_dir, f)\n    with open(fpath) as fh:\n        data = yaml.safe_load(fh)\n    \n    old_prefix = data.get('game', {}).get('prefix', '')\n    slug = slugify(title)\n    new_prefix = f'/home/johncoffee/Games/Heroic/Prefixes/{slug}'\n    \n    if old_prefix == new_prefix:\n        continue\n    \n    data.setdefault('game', {})['prefix'] = new_prefix\n    \n    with open(fpath, 'w') as fh:\n        yaml.dump(data, fh, default_flow_style=False, sort_keys=False)\n    \n    print(f'{old_prefix.split(\\\"/\\\")[-1]:15s} -> {slug:40s} ({title})')\n    changes += 1\n\nprint(f'\\nTotal YAMLs updated: {changes}')\n\"" action.permission=* action.action=allow action.pattern=*
