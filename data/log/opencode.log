timestamp=2026-07-13T18:54:12.603Z level=INFO run=047e387f message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport struct\n\ndata = open('/mnt/dados/gpu-fw/mi50/pp_table_patches/pp_table_2140mhz.bin', 'rb').read()\n\n# Regiao de SCLK freq (0x330-0x360)\nprint(\"=== Regiao 0x0330-0x0360 (tabela SCLK) ===\")\nfor off in range(0x0330, 0x0360, 16):\n    vals = [struct.unpack('<H', data[off+i:off+i+2])[0] for i in range(0, 16, 2)]\n    hexs = ' '.join(f'{b:02x}' for b in data[off:off+16])\n    print(f\"0x{off:04x}: {hexs}  -> {vals}\")\n\n# Regiao de MCLK (0x0390-0x03B0)\nprint(\"\\n=== Regiao 0x0390-0x03B0 (tabela MCLK?) ===\")\nfor off in range(0x0390, 0x03B0, 16):\n    vals = [struct.unpack('<H', data[off+i:off+i+2])[0] for i in range(0, 16, 2)]\n    hexs = ' '.join(f'{b:02x}' for b in data[off:off+16])\n    print(f\"0x{off:04x}: {hexs}  -> {vals}\")\n\n# Procurar 1162 mV = 0x048a\nprint(f\"\\n1162 mV (0x048a) encontrado em:\")\nfor i in range(0, len(data)-1):\n    if struct.unpack('<H', data[i:i+2])[0] == 1162:\n        print(f\"  0x{i:04x}  ctx: {' '.join(f'{b:02x}' for b in data[max(0,i-4):i+6])}\")\nPYEOF" action.permission=bash action.pattern="python3 *" action.action=allow
