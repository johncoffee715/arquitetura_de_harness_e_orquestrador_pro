timestamp=2026-07-13T19:50:38.259Z level=INFO run=005dc7fd message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport subprocess\n\ndata = bytearray(open('amdvbflash_patched', 'rb').read())\n\n# Find \"BIOS authentication signature mismatched\" string\ns1 = b'BIOS authentication signature mismatched'\nidx1 = data.find(s1)\nprint(f\"String 1: offset 0x{idx1:06x}\")\n\n# Find \"The result of RSA signature verify is Passed\" string  \ns2 = b'The result of RSA signature verify is Passed(DirTbl).'\nidx2 = data.find(s2)\nprint(f\"String 2 (Passed): offset 0x{idx2:06x}\")\n\n# Find \"The result of RSA signature verify is FAILED.\" string\ns3 = b'The result of RSA signature verify is FAILED.'\nidx3 = data.find(s3)\nprint(f\"String 3 (FAILED): offset 0x{idx3:06x}\")\n\n# Find \"The result of RSA signature verify is PASS.\" \ns4 = b'The result of RSA signature verify is PASS.'\nidx4 = data.find(s4)\nprint(f\"String 4 (PASS): offset 0x{idx4:06x}\")\n\n# Search for xrefs to these strings\n# In x86-64, a string reference is typically via LEA instruction: lea rdi, [rip+offset]\n# The instruction encoding for lea rdi, [rip+disp32] is: 48 8d 3d XX XX XX XX\n# where XX XX XX XX is the signed 32-bit displacement from the next instruction\n\nfor name, idx in [(\"FAILED_STR\", idx3), (\"PASS_STR\", idx4), (\"MISMATCH_STR\", idx1)]:\n    # Search for references\n    count = 0\n    for i in range(len(data) - 8):\n        # lea rdi, [rip+disp32] = 48 8d 3d XX XX XX XX\n        if data[i:i+3] == bytes([0x48, 0x8d, 0x3d]):\n            disp = int.from_bytes(data[i+3:i+7], 'little', signed=True)\n            target = i + 7 + disp  # RIP points to next instruction\n            if target == idx:\n                count += 1\n                print(f\"  [RSA ref] {name} at 0x{i:06x}: lea rdi, [rip+0x{disp:x}] (-> 0x{target:06x})\")\n    if count == 0:\n        # Try mov esi/edi, offset (32-bit absolute)\n        for i in range(len(data) - 5):\n            if data[i] == 0xbe:  # mov esi, imm32\n                val = int.from_bytes(data[i+1:i+5], 'little')\n                if val == idx:\n                    count += 1\n                    print(f\"  [RSA ref] {name} at 0x{i:06x}: mov esi, 0x{val:06x}\")\n            if data[i] == 0xbf:  # mov edi, imm32\n                val = int.from_bytes(data[i+1:i+5], 'little')\n                if val == idx:\n                    count += 1\n                    print(f\"  [RSA ref] {name} at 0x{i:06x}: mov edi, 0x{val:06x}\")\n    if count == 0:\n        print(f\"  [RSA ref] {name}: NOT FOUND via direct LEA\")\n\nPYEOF" action.permission=* action.action=allow action.pattern=*
