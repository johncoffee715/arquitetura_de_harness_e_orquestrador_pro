timestamp=2026-07-10T22:34:20.375Z level=INFO run=64d83dc1 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport struct\n\nwith open('/sys/class/drm/card1/device/pp_table', 'rb') as f:\n    data = f.read()\n\n# Check if TDP was already patched (look for 0xBE bytes)\ncount_be = data.count(b'\\xbe')\ncount_015e = data.count(b'\\x5e\\x01')\n\nprint(f\"0xBE bytes: {count_be}\")\nprint(f\"0x015E sequences: {count_015e}\")\n\n# Where are 0xBE?\nfor i, b in enumerate(data):\n    if b == 0xBE:\n        print(f\"  0xBE at offset {i}\")\n\n# Original TDP: 190W = 0xBE  \n# Patched TDP: 350W = 0x015E\n# These are stored as 2-byte values at specific offsets\n# On Vega20, TDP is at pp_table offset 112-115 (sometimes)\ntdp_offsets = [112, 116, 376, 380]\nprint(\"\\n=== Power-related values ===\")\nfor off in tdp_offsets:\n    if off < len(data):\n        val = struct.unpack('<I', data[off:off+4])[0]\n        print(f\"  offset {off}: {val}W\")\n    # Also check 2-byte\n    if off < len(data):\n        val2 = struct.unpack('<H', data[off:off+2])[0]\n        print(f\"  offset {off} (16-bit): {val2}W\")\n\n# Check known frequency limits  \nprint(\"\\n=== Frequency limits ===\")\n# For Vega 20 these might be at specific offsets in the header\n# Check for uint16 max values\nfor off in range(0, 200, 2):\n    val = struct.unpack('<H', data[off:off+2])[0]\n    if val == 0x6A4:  # 1700 MHz\n        pass  # we already know about offset 39\n    if val == 0x3E8:  # 1000 MHz  \n        if off < 100:\n            print(f\"  0x3E8 (1000) at offset {off}\")\nPYEOF" action.permission=bash action.pattern="python3 *" action.action=allow
