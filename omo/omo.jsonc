    "categories": {
      "cognitivo": {
        "description": "F1 DESCOBERTA(prometheus·artistry·momus) + F2 CONTRATO(oracle·metis) + F5 REVISÃO(atlas·momus) + deep/multimodal transversal",
        "model": "local-orchestrator/orchestrator",
        "models": [
          {
            "model": "local-orchestrator/orchestrator"
          },
          {
            "model": "local-bonsai/bonsai-27b"
          }
        ]
      },
      "executor": {
        "description": "F4 EXECUÇÃO(hephaestus·quick·needle-L0) + F3 PLANO TDD(hephaestus)",
        "model": "local-qwen38-2b/qwen3.8-2b",
        "models": [
          {
            "model": "local-qwen38-2b/qwen3.8-2b"
          },
          {
            "model": "local-orchestrator/orchestrator"
          }
        ]
      },
      "refutacao": {
        "description": "loops de refutação: F1 brainstorm · F2 auditoria · F5 arquitetura (momus)",
        "model": "local-lfm/lfm2.5-230m",
        "models": [
          {
            "model": "local-lfm/lfm2.5-230m"
          },
          {
            "model": "local-qwen38-2b/qwen3.8-2b"
          }
        ]
      },
      "exploracao": {
        "description": "apoio transversal: busca/RAG (librarian·explore)",
        "model": "local-qwen/qwen-3.5-0.8b",
        "models": [
          {
            "model": "local-qwen/qwen-3.5-0.8b"
          },
          {
            "model": "local-qwen38-2b/qwen3.8-2b"
          }
        ]
      },
      "criativo": {
        "description": "F1 ideação/prosa sem viés (artistry)",
        "model": "local-bonsai/bonsai-27b",
        "models": [
          {
            "model": "local-bonsai/bonsai-27b"
          },
          {
            "model": "local-orchestrator/orchestrator"
          }
        ]
      }
    },
    "git_master": {
      "commit_footer": true,
      "include_co_authored_by": true,
      "git_env_prefix": "GIT_MASTER=1"
    }
  },
  "_migrations": [
    "2026-07-opencode-config-unification",
    "2026-08-reasoning-unification"
  ],
  "profiles": {}
}