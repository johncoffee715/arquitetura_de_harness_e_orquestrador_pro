{
  "version": "1.0.0",
  "description": "EventBus Central — desacoplamento entre agentes, comandos, hooks e MCPs",
  "topics": {
    "agent:registered": {
      "description": "Um novo agente foi registrado no Registry",
      "producers": [
        "agent-registry"
      ],
      "consumers": [
        "*"
      ]
    },
    "agent:capability:updated": {
      "description": "Capacidade de um agente foi alterada",
      "producers": [
        "agent-registry"
      ],
      "consumers": [
        "capability-router",
        "context-broker"
      ]
    },
    "agent:health:changed": {
      "description": "Status de saúde de um agente mudou",
      "producers": [
        "agent-monitor"
      ],
      "consumers": [
        "capability-router",
        "dashboard"
      ]
    },
    "workflow:phase:started": {
      "description": "Uma fase de workflow foi iniciada",
      "producers": [
        "gsd-executor"
      ],
      "consumers": [
        "context-broker",
        "otel-exporter",
        "dashboard"
      ]
    },
    "workflow:phase:completed": {
      "description": "Uma fase de workflow foi concluída",
      "producers": [
        "gsd-executor"
      ],
      "consumers": [
        "context-broker",
        "otel-exporter",
        "dashboard",
        "memory-keeper"
      ]
    },
    "workflow:phase:failed": {
      "description": "Uma fase de workflow falhou",
      "producers": [
        "gsd-executor"
      ],
      "consumers": [
        "context-broker",
        "otel-exporter",
        "dashboard",
        "auto-healer"
      ]
    },
    "hook:executed": {
      "description": "Um hook foi executado",
      "producers": [
        "hook-registry"
      ],
      "consumers": [
        "otel-exporter",
        "session-activity-tracker"
