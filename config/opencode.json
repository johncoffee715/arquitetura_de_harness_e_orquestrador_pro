{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-openagent@latest",
    "./plugins/ecc-session-delete"
  ],
  "permission": {
    "bash": "allow",
    "read": "allow",
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "mcp_ghidra": "allow",
    "mcp_openwork": "allow"
  },
  "mcp": {
    "ghidra": {
      "type": "remote",
      "url": "http://127.0.0.1:8080/mcp",
      "enabled": true,
      "timeout": 300000
    },
    "openwork": {
      "type": "remote",
      "enabled": true,
      "url": "https://api.openworklabs.com/mcp/agent",
      "oauth": {}
    }
  },
  "provider": {
    "local-lfm": {
      "api": "openai",
      "name": "LFM 2.5-1.6B (llama.cpp :8081)",
      "options": {
        "baseURL": "http://127.0.0.1:8081/v1",
        "apiKey": "llamacpp"
      },
      "models": {
        "lfm-2.5-1.6b": {
          "name": "lfm-2.5-1.6b",
          "limit": {
            "context": 2048,
            "output": 1024
          },
          "tool_call": true,
          "temperature": true
        }
      }
    },
    "local-nanbeige": {
      "api": "openai",
      "name": "Nanbeige 3B (llama.cpp :8082)",
      "options": {
        "baseURL": "http://127.0.0.1:8082/v1",
        "apiKey": "llamacpp"
      },
      "models": {
        "nanbeige-3b": {
          "name": "nanbeige-3b",
          "limit": {
            "context": 4096,
            "output": 2048
          },
          "tool_call": true,
          "temperature": true
