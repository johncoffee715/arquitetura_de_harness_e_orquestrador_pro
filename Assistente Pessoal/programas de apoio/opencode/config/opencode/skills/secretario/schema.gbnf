root ::= "{" ws "\"acao\"" ws ":" ws string ws "," ws "\"destino\"" ws ":" ws string ws "," ws "\"confidence\"" ws ":" ws number ws "," ws "\"payload\"" ws ":" ws payload ws "," ws "\"vetor_placebo\"" ws ":" ws boolean ws "," ws "\"exit_status\"" ws ":" ws status ws "}"
payload ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
value ::= string | number | boolean | "null"
string ::= "\"" [a-zA-Z0-9\-_/ .:;áàâãéèêíïóôõöúçñÁÀÂÃÉÈÊÍÏÓÔÕÖÚÇÑ]+ "\""
number ::= ("0" "." [0-9]+) | ("1" "." "0"+) | ([0-9]+ ("." [0-9]+)?)
boolean ::= "true" | "false"
status ::= "\"ok\"" | "\"failed\"" | "\"blocked\""
ws ::= [ \t\n]*
