# GBNF schema for fable-method output
# Token-level constraints for constrained decoding (fonte: gabarito.json)

FableOutput:
  classification: "trivial" | "question" | "task" | "plan-first"
  done_spec: text
  bounds: object
  classified_at: iso8601
  status: "success" | "failure"

# Constraints for the output
stop_tokens: ["</|eot_id|>"]
max_tokens: 1024

# Required fields (as per schema)
required: [classification, done_spec]
