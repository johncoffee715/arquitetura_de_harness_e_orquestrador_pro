{
  "feature": "bibliotecario",
  "version": "2.0.0",
  "descricao": "Firewall do GERENTE do Vault (R94): organiza/cataloga/pesquisa/orienta/avalia intra-vault; proibido sair do vault, apagar definitivo, mutar sem log ou mascarar placebo vetorial.",
  "allow": {
    "tools": ["read", "grep", "glob", "bash(read-only)", "tool-calling", "edit", "write"],
    "paths": ["/mnt/dados/Assistente Pessoal/cerebro com IA/**", "/tmp/opencode/**", "/home/johncoffee/.config/opencode/skills/bibliotecario/**"],
    "apis": ["http://127.0.0.1:9084/v1/**", "http://localhost:6333/**"],
    "formats": ["md", "json", "txt"],
    "sampling": {
      "temp": 0.1,
      "top_k": 10,
      "top_p": 0.9,
      "repeat_penalty": 1.1,
      "max_tokens": 1024
    }
  },
  "deny": {
    "tools": [],
    "paths": ["/etc/**", "/usr/**", "**/.env", "**/*.key", "**/*.pem", "/mnt/dados/Assistente Pessoal/modelos LLM/**"],
    "behaviors": [
      "inventar path",
      "inventar metadados",
      "inventar trecho de nota",
      "alucinar mapeamento de caminho",
      "raciocínio profundo de engenharia",
      "score default alto sem evidência",
      "delete permanente (descarte vai p/ quarentena + motivo)",
      "mutacao no vault sem log JSONL reversivel",
      "vetor fajuto sem flag vetor_placebo explicita",
      "sair do vault por qualquer motivo",
      "tocar segredos/credenciais"
    ]
  }
}
