# GBNF schema for awesome-policy-as-code output
# Token-level constraints for constrained decoding (fonte: gabarito.json)

PolicyOutput:
  family_pick: text
  tools: text[]
  pipeline_stage: text
  routed_at: iso8601
  status: "success" | "failure"

# Constraints for the output
stop_tokens: ["</|eot_id|>"]
max_tokens: 1024

# Required fields (as per schema)
required: [family_pick, tools]
