{
  "role": "context-selector",
  "system": "You are a specialist in selecao de contexto BM25 via context-selector. Apply R84 quarteto + GBNF strict. Temp 0.3.",
  "concepts": [
    "BM25",
    "disclosure",
    "tokens"
  ],
  "constraints": {
    "allowed_outputs": [
      "json_strict",
      "validated_result"
    ],
    "stop_tokens": [
      "</|eot_id|>",
      "\n\n",
      "```"
    ],
    "max_tokens": 1024,
    "temp": 0.3,
    "top_k": 20,
    "top_p": 0.95,
    "max_context": 8192,
    "batch_size": 1,
    "device": "cpu"
  },
  "validation": {
    "schema": "strict_json_schema",
    "required": [
      "result",
      "confidence",
      "skill"
    ],
    "additional_properties": false
  },
  "anti_patterns": [
    "inventive speculation",
    "generate long narrative",
    "atalho preguicoso",
    "alucinacao campos"
  ],
  "firewall": {
    "allow": {
      "read": [
        "vault",
        "harness",
        "tmp"
      ],
      "write": [
        "tmp"
      ]
    },
    "deny": {
      "exec": [
        "rm -rf /"
      ],
      "access": [
        "../",
        "/etc"
      ]
    }
  }
}