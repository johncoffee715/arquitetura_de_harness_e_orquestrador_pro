{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local-thalamus": {
      "api": "openai",
      "name": "L0.5 CÓRTEX COGNITIVO — roteamento semântico F0 (intent classification), ingestão de logs longos F4 SEM perda (RNN O(1)), validação semântica F3, auditoria de diffs F5/6. Coexiste com Needle L0 (sintático). :9084 — role:ingestor",
      "options": {
        "baseURL": "http://127.0.0.1:9084/v1",
        "apiKey": "llamacpp"
      },
      "models": {
        "ingestor": {
          "name": "role:ingestor",
          "limit": {
            "context": 1048576,
            "output": 4096
          },
          "tool_call": false
        }
      }
    },
    "local-orchestrator": {
      "api": "openai",
      "name": "ORQUESTRADOR ATIVO :8083 — role:orchestrator",
      "options": {
        "baseURL": "http://127.0.0.1:8083/v1",
        "apiKey": "llamacpp"
      },
      "models": {
        "orchestrator": {
          "name": "role:orchestrator",
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "tool_call": true
        }
      }
    },
    "local-descoberta": {
      "api": "openai",
      "name": "micro 1-bit 400 t/s :9093 :9093 — role:ingestor",
      "options": {
        "baseURL": "http://127.0.0.1:9093/v1",
        "apiKey": "llamacpp"
      },
      "models": {
        "ingestor": {
          "name": "role:ingestor",
          "limit": {
            "context": 4096,
            "output": 8192
          },
          "tool_call": true
        }
      }
    },
    "local-ternary": {
      "api": "openai",
      "name": "refuter/relay :9090 — extracao GBNF 10/10 :9090 — role:refuter",
      "options": {
        "baseURL": "http://127.0.0.1:9090/v1",
        "apiKey": "llamacpp"
      },
      "models": {
        "refuter": {
          "name": "role:refuter",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "tool_call": false
        }
      }
    },
    "local-forge": {
      "api": "openai",
      "name": "proposer :9088 (ctx 131072 — criterio canonico R84-EXEC01) :9088 — role:proposer",
      "options": {
        "baseURL": "http://127.0.0.1:9088/v1",
        "apiKey": "llamacpp"
      },
      "models": {
        "proposer": {
          "name": "role:proposer",
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "tool_call": true
        }
      }
    },
    "local-reflexo": {
      "api": "openai",
      "name": "reflexo/relay :9086 CPU — GBNF-conforme 2/2 :9086 — role:reflexo",
      "options": {
        "baseURL": "http://127.0.0.1:9086/v1",
        "apiKey": "llamacpp"
      },
      "models": {
        "reflexo": {
          "name": "role:reflexo",
          "limit": {
            "context": 128000,
            "output": 8192
          },
          "tool_call": true
        }
      }
    },
    "local-relay": {
      "api": "openai",
      "name": "relay intermediario :9092 :9092 — role:relay",
      "options": {
        "baseURL": "http://127.0.0.1:9092/v1",
        "apiKey": "llamacpp"
      },
      "models": {
        "relay": {
          "name": "role:relay",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "tool_call": true
        }
      }
    },
    "local-qwen3-embedding-0.6b": {
      "api": "openai",
      "name": "embedder tempo-real :9094 (bibliotecario query) :9094 — role:qwen3-embedding-0.6b-cpu",
      "options": {
        "baseURL": "http://127.0.0.1:9094/v1",
        "apiKey": "llamacpp"
      },
      "models": {
        "qwen3-embedding-0.6b-cpu": {
          "name": "role:qwen3-embedding-0.6b-cpu",
          "limit": {
            "context": 2048,
            "output": 8192
          },
          "tool_call": true
        }
      }
    },
    "local-executor": {
      "api": "openai",
      "name": "F4 EXECUTOR — motor de features, tool-calling estrito (GBNF), TDD, ctx 32k :9095 — role:proposer",
      "options": {
        "baseURL": "http://127.0.0.1:9095/v1",
        "apiKey": "llamacpp"
      },
      "models": {
        "proposer": {
          "name": "role:proposer",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "tool_call": true
        }
      }
    },
    "local-executor-noema-2b-q4ks": {
      "api": "openai",
      "name": "EXECUTOR-CEGO — obediencia estrita, forja, extracao JSON, ordens diretas (cru = estado otimo, sem quarteto) :9098 — role:proposer",
      "options": {
        "baseURL": "http://127.0.0.1:9098/v1",
        "apiKey": "llamacpp"
      },
      "models": {
        "proposer": {
          "name": "role:proposer",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "tool_call": true
        }
      }
    }
  },
  "model": "local-orchestrator/orchestrator",
  "small_model": "local-thalamus/ingestor",
  "instructions": [
    "/mnt/dados/Assistente Pessoal/cerebro com IA/regras/nucleo-irredutivel.md"
  ],
  "hooks": {
    "session.start": [
      "python3 /mnt/dados/Assistente Pessoal/programas de apoio/opencode/config/opencode/hooks/kronjob-talamus-filter.py",
      "python3 /mnt/dados/Assistente Pessoal/programas de apoio/opencode/config/opencode/hooks/sdd/sdd-talamus-filter.py",
      "python3 /mnt/dados/Assistente Pessoal/programas de apoio/opencode/config/opencode/hooks/sync-llm-stack.py",
      "python3 /mnt/dados/Assistente Pessoal/programas de apoio/opencode/config/opencode/hooks/stack-health-check.py",
      "python3 /mnt/dados/Assistente Pessoal/programas de apoio/opencode/config/opencode/hooks/inject-regras.py"
    ]
  },
  "permission": {
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*auth.json": "deny"
    },
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "rm -rf /*": "deny",
      "mkfs*": "deny",
      "dd *of=/dev/*": "deny",
      "shutdown *": "ask",
      "reboot *": "ask",
      "git push *": "ask",
      "git push --force*": "deny"
    },
    "external_directory": {
      "/mnt/dados/**": "allow",
      "/run/media/johncoffee/Ventoy/**": "allow"
    }
  },
  "skills": {
    "context-selector": {},
    "gran-mestre": {},
    "harness-kronjob-guardrail": {},
    "hefesto": {},
    "hefesto-decompilacao": {},
    "hefesto-autofagia": {},
    "hefesto-helenizacao": {},
    "hefesto-forja": {},
    "sdd": {},
    "sentinel-guard-security": {},
    "guardrail-llm-fitragem": {},
    "bibliotecario": {},
    "a2a-brainstorm": {},
    "log-summarizer": {},
    "needle-pytest-filter": {},
    "roteador-hibrido": {},
    "unlazy": {},
    "gari": {},
    "secretario": {}
  },
  "agents": [
    "gran-mestre",
    "hefesto",
    "sentinel-guard",
    "sdd-executor",
    "executor-f4",
    "planejador-f23",
    "juiz-limbico",
    "refutador-limbico",
    "reflexo-r42",
    "prosa-f2",
    "explorador-tool",
    "cortex-sensorial",
    "general",
    "explore",
    "bibliotecario"
  ],
  "watchers": {
    "features": {
      "path": "/mnt/dados/Assistente Pessoal/programas de apoio/opencode/config/opencode",
      "interval_seconds": 30,
      "log": "/mnt/dados/Assistente Pessoal/programas de apoio/opencode/state/watcher/features.log"
    }
  },
  "mcp": {
    "comfy-cloud": {
      "type": "remote",
      "url": "https://cloud.comfy.org/mcp",
      "headers": {
        "X-API-Key": "{env:COMFY_API_KEY}"
      },
      "enabled": false
    },
    "comfyui-local": {
      "type": "stdio",
      "command": "/mnt/dados/Assistente Pessoal/programas de apoio/comfy-mcp-venv/bin/comfy-mcp",
      "env": {
        "COMFY_BIN": "/mnt/dados/Assistente Pessoal/programas de apoio/comfy-mcp-venv/bin/comfy"
      },
      "enabled": true
    },
    "civitai-site": {
      "type": "remote",
      "url": "https://mcp.civitai.com/mcp",
      "enabled": true
    },
    "civitai-orchestration": {
      "type": "remote",
      "url": "https://orchestration.civitai.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:CIVITAI_API_KEY}"
      }
    }
  }
}
