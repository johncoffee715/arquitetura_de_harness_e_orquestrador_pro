[
  {
    "name": "mover_nota",
    "description": "Move a note file to a destination folder",
    "parameters": {
      "type": "object",
      "properties": {
        "path_origem": {"type": "string", "description": "source note path or filename like nota-x.md"},
        "path_destino": {"type": "string", "description": "destination path or folder like arquivadas/nota-x.md"}
      },
      "required": ["path_origem", "path_destino"]
    }
  },
  {
    "name": "adicionar_tag",
    "description": "Add a tag to a vault note",
    "parameters": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "description": "vault-relative note path"},
        "tag": {"type": "string", "description": "tag without hash like filosofia"}
      },
      "required": ["path", "tag"]
    }
  },
  {
    "name": "registrar",
    "description": "Record a decision, note or reminder text",
    "parameters": {
      "type": "object",
      "properties": {
        "texto": {"type": "string", "description": "content to record"},
        "tipo": {"type": "string", "description": "decisao, nota or lembrete"}
      },
      "required": ["texto"]
    }
  },
  {
    "name": "agendar",
    "description": "Create a reminder or commitment",
    "parameters": {
      "type": "object",
      "properties": {
        "descricao": {"type": "string", "description": "what to remind"},
        "quando": {"type": "string", "description": "when, e.g. amanha, em 2 dias"}
      },
      "required": ["descricao", "quando"]
    }
  },
  {
    "name": "catalogar_nota",
    "description": "Classify a note into a thematic index",
    "parameters": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "description": "vault-relative note path"},
        "tema": {"type": "string", "description": "thematic folder like filosofia"}
      },
      "required": ["path", "tema"]
    }
  }
]
