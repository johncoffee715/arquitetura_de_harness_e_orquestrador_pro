  "model": "local-orchestrator/orchestrator",
  "small_model": "local-thalamus/ingestor",
  "instructions": [
    "/mnt/dados/Assistente Pessoal/cerebro com IA/regras/nucleo-irredutivel.md"
  ],
  "hooks": {
    "session.start": [
      "python3 /mnt/dados/Assistente Pessoal/opencode/config/opencode/hooks/kronjob-talamus-filter.py",
      "python3 /mnt/dados/Assistente Pessoal/opencode/config/opencode/hooks/sdd/sdd-talamus-filter.py",
      "python3 /mnt/dados/Assistente Pessoal/opencode/config/opencode/hooks/sync-llm-stack.py",
      "python3 /mnt/dados/Assistente Pessoal/opencode/config/opencode/hooks/stack-health-check.py",
      "python3 /mnt/dados/Assistente Pessoal/opencode/config/opencode/hooks/inject-regras.py"
    ]
  },
  "permission": {
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*auth.json": "deny"
    },
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "rm -rf /*": "deny",
      "mkfs*": "deny",
      "dd *of=/dev/*": "deny",
      "shutdown *": "ask",
      "reboot *": "ask",
      "git push *": "ask",
      "git push --force*": "deny"
    },
    "external_directory": {
      "/mnt/dados/**": "allow",
      "/run/media/johncoffee/Ventoy/**": "allow"
    }
  },
  "skills": {
    "context-selector": {},
    "gran-mestre": {},
    "harness-kronjob-guardrail": {},
    "hefesto": {},
    "hefesto-decompilacao": {},
    "hefesto-autofagia": {},
    "hefesto-helenizacao": {},
    "hefesto-forja": {},
    "sdd": {},
    "sentinel-guard-security": {},
    "guardrail-llm-fitragem": {},
    "bibliotecario": {},
    "a2a-brainstorm": {},
    "log-summarizer": {},
    "needle-pytest-filter": {},
    "roteador-hibrido": {},
    "unlazy": {},
    "gari": {},
    "secretario": {}
  },
  "agents": [
    "gran-mestre",
    "hefesto",
    "sentinel-guard",
    "sdd-executor",
    "executor-f4",
    "planejador-f23",
    "juiz-limbico",
    "refutador-limbico",
    "reflexo-r42",
    "prosa-f2",
    "explorador-tool",
    "cortex-sensorial",
    "general",
    "explore",
    "bibliotecario"
  ],
  "watchers": {
    "features": {
      "path": "/mnt/dados/Assistente Pessoal/opencode/config/opencode",
      "interval_seconds": 30,
      "log": "/mnt/dados/Assistente Pessoal/opencode/state/watcher/features.log"
    }
  }
}
