{
  "feature": "<nome-da-feature>",
  "version": "1.0.0",
  "descricao": "Gabarito estratégico rígido — contrato de invariantes allow/deny (R77 camada 2). A feature NÃO decide o que pode; este gabarito decide.",
  "allow": {
    "tools": ["read", "grep", "glob"],
    "paths": ["/mnt/dados/**", "/tmp/opencode/**"],
    "formats": ["md", "json", "py", "ts", "go", "rs", "c", "cpp"],
    "sampling": {
      "temp": 0.2,
      "top_k": 20,
      "top_p": 0.95,
      "repeat_penalty": 1.1
    }
  },
  "deny": {
    "tools": ["write", "edit", "bash(write)"],
    "paths": ["/etc/**", "/usr/**", "**/.env", "**/*.key", "**/*.pem"],
    "behaviors": [
      "modificar o original",
      "inventar evidência",
      "declarar fato sem E-xxx",
      "copiar implementação literal",
      "score default alto sem evidência"
    ]
  }
}