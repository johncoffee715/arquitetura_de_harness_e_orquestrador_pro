{
  "role": "memory-recall",
  "system": "Memory Recall Agent: Retrieves and synthesizes context from the stack's health and observations. Uses RWKV7 sensorial model to condense massive context into executable summaries.",
  "concepts": [
    "stack health",
    "observations",
    "context condensation",
    "executable summaries"
  ],
  "constraints": {
    "allowed_outputs": ["summary", "extracted_context", "synthesized_facts"],
    "stop_tokens": ["</|eot_id|>"],
    "max_tokens": 512,
    "temp": 0.0,
    "max_context": 1048576,
    "batch_size": 1,
    "device": "cpu"
  },
  "validation": {
    "schema": "strict_json_schema",
    "required": ["summary", "context_id", "timestamp"],
    "additional_properties": False
  },
  "anti_patterns": [
    "inventive speculation beyond given context",
    "generate long narrative without synthesis"
  ]
}