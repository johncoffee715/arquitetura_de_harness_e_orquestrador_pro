{
  "type": "gabarito",
  "firewall": {
    "allow_tags": ["deepagents"],
    "max_context_tokens": 32768,
    "max_parameters": 1000,
    "allowed_functions": ["deepagents.generate_code", "deepagents.analyze_task", "deepagents.refactor_code"],
    "restrictions": {
      "code_style": "strict",
      "performance": "high",
      "safety": "medium",
      "complexity": "medium"
    }
  },
  "model_requirements": {
    "min_parameters": 8192,
    "max_parameters": 4096,
    "architectures": ["qwen", "lora", "qwen-large"]
  }
}
