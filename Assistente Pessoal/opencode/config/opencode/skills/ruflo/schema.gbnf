# GBNF schema for ruflo output
# Token-level constraints for constrained decoding (fonte: gabarito.json)

RufloOutput:
  topology_pick: "hierarchical" | "mesh" | "adaptive"
  memory_plan: object
  picked_at: iso8601
  status: "success" | "failure"

# Constraints for the output
stop_tokens: ["</|eot_id|>"]
max_tokens: 1024

# Required fields (as per schema)
required: [topology_pick, memory_plan]
