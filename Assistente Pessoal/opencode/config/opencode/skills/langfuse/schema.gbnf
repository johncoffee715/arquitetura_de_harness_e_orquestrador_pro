# GBNF schema for langfuse output
# Token-level constraints for constrained decoding (fonte: gabarito.json)

LangfuseOutput:
  trace_spec: text
  dataset_run: text
  eval_report: object
  recorded_at: iso8601
  status: "success" | "failure"

# Constraints for the output
stop_tokens: ["</|eot_id|>"]
max_tokens: 1024

# Required fields (as per schema)
required: [trace_spec, eval_report]
