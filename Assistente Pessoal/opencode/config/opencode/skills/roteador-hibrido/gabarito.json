{
  "feature": "roteador-hibrido",
  "version": "1.0.0",
  "descricao": "Firewall do Porteiro — RWKV7 classifica (semântico), Needle executa (sintático); proibido acordar GPU à toa, inventar intento ou payload não-estrito.",
  "allow": {
    "tools": ["read", "bash(read-only)", "tool-calling"],
    "apis": ["http://127.0.0.1:9084/v1/**", "http://127.0.0.1:9091/complete"],
    "paths": ["/tmp/opencode/**", "/mnt/dados/Assistente Pessoal/opencode/config/opencode/**"],
    "formats": ["json"],
    "sampling": {
      "rwkv": {"temp": 0.1, "max_tokens": 128},
      "needle": {"temp": 0.0, "max_tokens": 256}
    }
  },
  "deny": {
    "tools": ["edit", "write"],
    "paths": ["/etc/**", "/usr/**", "**/.env", "**/*.key"],
    "behaviors": [
      "acordar GPU para comando direto",
      "inventar intento",
      "payload não-estrito na rota direta",
      "RWKV7 sem GBNF para JSON",
      "score default alto sem evidência"
    ]
  }
}