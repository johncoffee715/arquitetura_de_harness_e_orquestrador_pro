timestamp=2026-07-10T06:37:06.275Z level=INFO run=b6021c4b message=evaluated permission=bash pattern="python3 - <<'PY'\nimport pty, os, time, select, fcntl, termios, struct, re\n\ndef full_test(enter_byte, label):\n    master, slave = pty.openpty()\n    winsize = struct.pack(\"HHHH\", 30, 100, 0, 0)\n    fcntl.ioctl(slave, termios.TIOCSWINSZ, winsize)\n    env = dict(os.environ); env[\"TERM\"]=\"alacritty\"; env[\"COLORTERM\"]=\"truecolor\"\n    pid = os.fork()\n    if pid==0:\n        os.close(master); os.setsid()\n        os.dup2(slave,0); os.dup2(slave,1); os.dup2(slave,2)\n        os.chdir(\"/tmp\")\n        os.execvpe(\"/home/johncoffee/.opencode/bin/opencode\",[\"opencode\"],env)\n    os.close(slave)\n    def read(t=3):\n        out=b\"\"; end=time.time()+t\n        while time.time()<end:\n            r,_,_=select.select([master],[],[],0.05)\n            if r:\n                try: d=os.read(master,65536)\n                except OSError: break\n                if not d: break\n                out+=d\n                # respond to terminal queries automatically\n                if b\"\\x1b[6n\" in d:  # CPR\n                    os.write(master, b\"\\x1b[1;1R\")\n                if b\"\\x1b[c\" in d or b\"\\x1b[>c\" in d:  # DA1/DA2\n                    os.write(master, b\"\\x1b[?62;22c\")  # pretend we're a VT220\n                if b\"\\x1b_G\" in d and b\"a=q\" in d:  # Kitty graphics query\n                    pass  # just ignore\n                if b\"\\x1b[?1004$p\" in d:  # focus tracking support\n                    os.write(master, b\"\\x1b[?1004;2$y\")\n                if b\"\\x1b[?2027$p\" in d:\n                    os.write(master, b\"\\x1b[?2027;2$y\")\n                if b\"\\x1b[?2004$p\" in d:\n                    os.write(master, b\"\\x1b[?2004;2$y\")\n                if b\"\\x1b[?2026$p\" in d:\n                    os.write(master, b\"\\x1b[?2026;2$y\")\n                if b\"\\x1b[?2031$p\" in d:\n                    os.write(master, b\"\\x1b[?2031;2$y\")\n                if b\"\\x1b[?1016$p\" in d:\n                    os.write(master, b\"\\x1b[?1016;2$y\")\n                if b\"\\x1bP+q\" in d:  # terminfo query\n                    os.write(master, b\"\\x1bP1+r\\x1b\\\\\")\n                if b\"\\x1b]10;?\" in d:  # OSC color query\n                    os.write(master, b\"\\x1b]10;#eeeeee\\x1b\\\\\")\n                if b\"\\x1b]11;?\" in d:\n                    os.write(master, b\"\\x1b]11;#101010\\x1b\\\\\")\n                end=time.time()+0.3\n        return out\n    boot = read(8)\n    print(f\"[{label}] boot: {len(boot)} bytes\")\n    # type /help and enter\n    os.write(master, b\"/help\"); time.sleep(0.5)\n    os.write(master, enter_byte)\n    post = read(4)\n    clean = re.sub(rb'\\x1b\\[[0-9;?]*[a-zA-Z]', b'', post)\n    clean = re.sub(rb'\\x1b\\][^\\x07\\x1b]*[\\x07\\x1b\\\\]', b'', clean)\n    clean = re.sub(rb'\\x1bP[^\\x1b]*\\x1b\\\\', b'', clean)\n    clean = re.sub(rb'\\x1b_[^\\x1b]*\\x1b\\\\', b'', clean)\n    clean = clean.strip()\n    print(f\"  post-enter: {len(post)} bytes, clean: {clean[:300]!r}\")\n    has_help = b\"Help\" in post or b\"help\" in clean.lower()\n    has_menu = b\"commands\" in clean.lower() or b\"agents\" in clean.lower()\n    print(f\"  Help response: {has_help}, Menu appeared: {has_menu}\")\n    try: os.write(master,b\"\\x03\")\n    except: pass\n    try: os.kill(pid,9)\n    except: pass\n    print()\n\nprint(\"### SEM tui.json (plugin removido) ###\")\nfull_test(b\"\\r\", \"CR sem plugin\")\nprint(\"### com LF ###\")\nfull_test(b\"\\n\", \"LF sem plugin\")\nPY" action.permission=* action.action=allow action.pattern=*
