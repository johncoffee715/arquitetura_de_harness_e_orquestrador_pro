                    "base_url": "http://127.0.0.1:8083",
                    "kind": "local",
                    "priority": 10
                },
                "local-bonsai": {
                    "base_url": "http://127.0.0.1:8084",
                    "kind": "local",
                    "priority": 20
                },
                "local-nanbeige": {
                    "base_url": "http://127.0.0.1:8082",
                    "kind": "local",
                    "priority": 30
                },
                "local-lfm": {
                    "base_url": "http://127.0.0.1:8081",
                    "kind": "local",
                    "priority": 40
                },
                "omniroute": {
                    "base_url": "http://localhost:20128",
                    "kind": "gateway",
                    "priority": 50
                }
            },
            "defaults": {
                "subagent": "local-ornith",
                "skill": "omniroute",
                "hook": "omniroute",
                "mcp": "omniroute",
                "lsp": "omniroute",
                "plugin": "omniroute",
                "tool": "omniroute"
