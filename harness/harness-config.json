        "vram_budget": {
            "total_gb": 16,
            "models_allocated_gb": 11.9,
            "kv_cache_reserved_gb": 4.1,
            "safety_margin_gb": 0
        },
        "pipeline": {
            "phases": [
                {
                    "number": 1,
                    "name": "Discovery",
                    "tags": [
                        "discovery",
                        "research",
                        "interview",
                        "brainstorming"
                    ],
                    "model": "Ornith-1.0 9B",
                    "temperature": 0.7,
                    "grammar": "json.gbnf",
                    "filters": [
                        "LFM 2.5",
                        "Nanbeige 3B"
                    ],
                    "gate": "Gate 1: Direction approval"
                },
                {
                    "number": 2,
                    "name": "Contract",
                    "tags": [
                        "spec",
                        "contract",
                        "design",
                        "validation"
                    ],
                    "model": "Bonsai 27B 1-bit",
                    "temperature": 0.2,
                    "grammar": "json.gbnf",
                    "filters": [
                        "Nanbeige 3B"
                    ],
                    "gate": "Gate 2: Spec approval"
                },
                {
                    "number": 3,
                    "name": "Plan",
                    "tags": [
                        "planning",
                        "tdd",
                        "tasks",
                        "decomposition"
                    ],
                    "model": "Bonsai 27B 1-bit",
                    "temperature": 0.2,
                    "grammar": "json.gbnf",
                    "filters": [
                        "LFM 2.5",
                        "Nanbeige 3B"
                    ],
                    "gate": "Gate 3: Plan approval",
                    "safety_checkpoint": true
                },
                {
                    "number": 4,
                    "name": "Execution",
                    "tags": [
                        "execution",
                        "implementation",
                        "coding",
                        "git"
                    ],
                    "model": "Bonsai 27B 1-bit",
                    "temperature": 0.1,
                    "grammar": "code.gbnf",
                    "context": 16384,
                    "filters": [
                        "LFM 2.5",
                        "Nanbeige 3B"
                    ],
                    "gate": "None — atomic commits",
                    "dev_loop": "N1/ReAct per task"
                },
                {
                    "number": 5,
                    "name": "Macro Review",
                    "tags": [
                        "review",
                        "macro",
                        "architecture",
                        "audit"
                    ],
                    "model": "Ornith-1.0 9B + MoE (cloud)",
                    "temperature": 0.1,
                    "grammar": "json.gbnf",
                    "filters": [
                        "Nanbeige 3B"
                    ],
                    "gate": "None — report"
                },
                {
                    "number": 6,
                    "name": "Delivery",
                    "tags": [
                        "delivery",
                        "verification",
                        "release",
                        "memory"
                    ],
                    "model": "Ornith-1.0 9B + MoE (cloud)",
                    "filters": [
                        "LFM 2.5"
                    ],
                    "gate": "Gate 4: Final report → cerebral memory"
                }
            ]
        },
        "safety_protocol": {
            "sha_checkpoint_phase": 3,
            "git_diff_check": true,
            "rollback_on_failure": true,
            "hestia_validator": true,
            "never_partial_state": true
        },
        "observability": {
            "context_file": ".planning/CONTEXT.md",
            "metrics_format": "[Metrics] Phase: {phase}\n[Metrics] Route: {route}\n[Metrics] Status: {status}",
            "otel_enabled": true,
            "melt_tracking": true,
            "semantic_conventions": "genai"
        },
        "dev_loop": {
            "level_1": {
                "name": "ReAct",
                "use_for": "Trivial tasks (1-3 files)",
                "max_iterations": 3,
                "escalates_to": 2
            },
            "level_2": {
                "name": "Mini Loop",
                "use_for": "Features (1 module, clear requirements)",
                "max_cycles": 2,
                "escalates_to": 3
            },
            "level_3": {
                "name": "Human Loop",
                "use_for": "Epics, architectural decisions, multi-module",
                "termination": "Human decision"
            }
        },
        "language_policy": {
            "internal_communication": "en",
            "user_output": "pt-br",
            "note": "comunicação entre submodelos/recursos em inglês (precisão técnica); relatórios, resumos e respostas ao usuário em português"
        },
        "reasoning_policy": {
            "principle": "reasoning longo somente se necessário",
            "budget_tokens": 1024,
            "implementation": "--reasoning-budget 1024 (llama-server) — ornith e bonsai",
            "note": "tarefas simples → resposta direta; tarefas complexas → reasoning até o budget"
        }
    }
}